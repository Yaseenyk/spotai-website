---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../site';
import { strings } from '../i18n/strings';
import { langOf, localize } from '../i18n/config';
const code = langOf(Astro.url.pathname);
const T = strings(code);
const t = T.pricing;
const home = new URL(localize('/', code), SITE.url).href;
const url = new URL(localize('/pricing/', code), SITE.url).href;
const wa = `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(T.common.waOwnerPilot)}`;
const askOwner = `https://wa.me/?text=${encodeURIComponent(T.common.waAskOwner(new URL(localize('/for-gym-owners/', code), SITE.url).href))}`;
const { title, description } = t;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebPage', '@id': url, url, name: title, description, isPartOf: { '@id': `${SITE.url}#website` } },
    { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'SpotAI', item: home }, { '@type': 'ListItem', position: 2, name: t.crumb, item: url }] },
  ],
};
---

<Layout title={`${title} · SpotAI`.length <= 65 ? `${title} · SpotAI` : title} description={description} jsonLd={jsonLd}>
  <Nav />
  <main id="main" class="pr">
    <div class="wrap">
      <h1 class="wide">{t.h1}</h1>
      <p class="lead">{t.lead}</p>
      <div class="plans">
        <section class="plan plan--gym" aria-labelledby="plan-gym">
          <p class="plan__for">{t.gym.for}</p>
          <h2 id="plan-gym"><span class="plan__price">{t.gym.price}</span> {t.gym.per}</h2>
          <p class="plan__sub">{t.gym.sub}</p>
          <ul>
            {t.gym.items.map((i) => <li>{i}</li>)}
          </ul>
          <a href={wa} target="_blank" rel="noopener" class="btn btn--primary">{T.common.chatWhatsApp}</a>
          <a href={localize('/for-gym-owners/', code)} class="plan__link">{t.gym.link}</a>
        </section>
        <section class="plan" aria-labelledby="plan-member">
          <p class="plan__for">{t.member.for}</p>
          <h2 id="plan-member"><span class="plan__price">{t.member.price}</span></h2>
          <p class="plan__sub">{t.member.sub}</p>
          <ul>
            {t.member.items.map((i) => <li>{i}</li>)}
          </ul>
          <a href={askOwner} target="_blank" rel="noopener" class="btn btn--ghost">{t.member.cta}</a>
        </section>
      </div>
      <section class="notes" aria-labelledby="notes-title">
        <h2 id="notes-title">{t.notes.title}</h2>
        <ul>
          {t.notes.items.map((i) => <li>{i}</li>)}
        </ul>
      </section>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .pr {
    padding: 128px 0 80px;
    font-size: 17px;
  }
  .pr h1 {
    font-size: clamp(34px, 4vw, 56px);
  }
  .pr .lead {
    margin-top: 14px;
    font-size: 18px;
  }
  .plans {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin-top: 40px;
  }
  .plan {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 28px;
    border-radius: 20px;
    background: linear-gradient(180deg, #1f2129, #171920);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.07),
      0 0 0 1px var(--line);
  }
  .plan--gym {
    background: rgba(139, 92, 246, 0.14);
    box-shadow: inset 0 0 0 1px rgba(196, 181, 253, 0.35);
  }
  .plan__for {
    font-size: 13px;
    font-weight: 700;
    color: var(--violet-2);
  }
  .plan h2 {
    font-size: 24px;
  }
  .plan__price {
    font-size: 44px;
    font-variation-settings: 'wdth' 118;
    letter-spacing: -0.03em;
  }
  .plan__sub {
    color: var(--steel);
  }
  .plan ul {
    margin: 8px 0 12px;
    padding-left: 20px;
    line-height: 1.7;
    color: var(--steel);
  }
  .plan .btn {
    justify-self: start;
  }
  .plan__link {
    font-size: 14px;
    color: var(--violet-2);
  }
  .notes {
    margin-top: 48px;
    padding: 24px 28px;
    border-radius: 16px;
    background: rgba(251, 191, 36, 0.07);
    box-shadow: inset 0 0 0 1px rgba(251, 191, 36, 0.25);
  }
  .notes h2 {
    font-size: 20px;
    color: var(--warn);
  }
  .notes ul {
    margin: 10px 0 0;
    padding-left: 20px;
    line-height: 1.65;
    color: var(--steel);
  }
  @media (max-width: 760px) {
    .plans {
      grid-template-columns: 1fr;
    }
    .pr {
      padding-top: 108px;
    }
  }
</style>
