---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Screen from '../components/Screen.astro';
import { SITE } from '../site';
import { featureFor } from '../i18n/features';
import { strings } from '../i18n/strings';
import { langOf, localize } from '../i18n/config';
interface Props {
  slug: string;
}
const code = langOf(Astro.url.pathname);
const t = strings(code).featurePage;
const f = featureFor(code, Astro.props.slug);
const home = localize('/', code);
const url = new URL(localize(`/features/${f.slug}/`, code), SITE.url).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': url,
      url,
      name: f.title,
      description: f.description,
      isPartOf: { '@id': `${SITE.url}#website` },
      about: { '@id': `${SITE.url}#org` },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'SpotAI', item: new URL(home, SITE.url).href },
        { '@type': 'ListItem', position: 2, name: t.crumb, item: new URL(localize('/features/', code), SITE.url).href },
        { '@type': 'ListItem', position: 3, name: f.nav, item: url },
      ],
    },
    {
      '@type': 'HowTo',
      name: f.title,
      step: f.steps.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, name: s.title, text: s.body })),
    },
    {
      '@type': 'FAQPage',
      mainEntity: f.faq.map((q) => ({ '@type': 'Question', name: q.q, acceptedAnswer: { '@type': 'Answer', text: q.a } })),
    },
  ],
};
const who = t.who[f.audience];
---

<Layout title={`${f.title} · SpotAI`.length <= 65 ? `${f.title} · SpotAI` : f.title} description={f.description} jsonLd={jsonLd}>
  <Nav />
  <main id="main" class="feat">
    <section class="hero">
      <div class="wrap hero__in">
        <div class="hero__copy">
          <nav class="crumbs" aria-label={strings(code).common.breadcrumb}>
            <a href={home}>SpotAI</a><span aria-hidden="true">/</span><a href={localize('/features/', code)}>{t.crumb}</a><span aria-hidden="true">/</span><span>{f.nav}</span>
          </nav>
          <p class="hero__for">{who}</p>
          <h1 class="hero__title wide">{f.problem}</h1>
          <p class="hero__fix">{f.fix}</p>
          <p class="hero__lead">{f.lead}</p>
          <div class="hero__cta">
            <a href={`${home}#download`} class="btn btn--primary">{t.cta}</a>
            <a href="#how" class="btn btn--ghost">{t.how}</a>
          </div>
        </div>
        <div class:list={['hero__art', `hero__art--${f.hero.kind}`]}>
          <Screen shot={f.hero} eager />
        </div>
      </div>
    </section>
    <section class="facts" aria-label={t.factsLabel}>
      <ul class="wrap facts__in" role="list">
        {
          f.facts.map(([n, l]) => (
            <li>
              <b class="wide">{n}</b>
              <span>{l}</span>
            </li>
          ))
        }
      </ul>
    </section>
    <section class="section how" id="how" aria-labelledby="how-title">
      <div class="wrap">
        <h2 id="how-title">{t.howTitle}</h2>
        <ol class="steps" role="list">
          {
            f.steps.map((s, i) => (
              <li class:list={['step', `step--${s.shot.kind}`]}>
                <div class="step__text">
                  <span class="step__n" aria-hidden="true">{i + 1}</span>
                  <h3>{s.title}</h3>
                  <p>{s.body}</p>
                </div>
                <div class="step__art">
                  <Screen shot={s.shot} />
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>
    <section class="section get" aria-labelledby="get-title">
      <div class="wrap">
        <h2 id="get-title">{t.getTitle}</h2>
        <ul class="details" role="list">
          {
            f.details.map((d) => (
              <li>
                <h3>{d.title}</h3>
                <p>{d.body}</p>
              </li>
            ))
          }
        </ul>
        <div class="limits">
          <h3>{t.limits}</h3>
          <ul>{f.limits.map((l) => <li>{l}</li>)}</ul>
        </div>
      </div>
    </section>
    <section class="section faq" aria-labelledby="faq-title">
      <div class="wrap faq__in">
        <h2 id="faq-title">{t.faqTitle}</h2>
        <div>
          {
            f.faq.map((q, i) => (
              <details open={i === 0}>
                <summary>
                  <h3>{q.q}</h3>
                  <span class="plus" aria-hidden="true" />
                </summary>
                <p>{q.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>
    <section class="section more" aria-labelledby="more-title">
      <div class="wrap">
        <h2 id="more-title">{t.moreTitle}</h2>
        <ul class="more__grid" role="list">
          {
            f.related.map((r) => {
              const o = featureFor(code, r);
              return (
                <li>
                  <a href={localize(`/features/${o.slug}/`, code)}>
                    <span>{o.nav}</span>
                    <strong>{o.problem}</strong>
                    <em>{o.fix}</em>
                  </a>
                </li>
              );
            })
          }
          <li class="more__cta">
            <a href={`${home}#download`}>
              <span>{t.moreCta.kicker}</span>
              <strong>{t.moreCta.title}</strong>
              <em>{t.moreCta.text}</em>
            </a>
          </li>
        </ul>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .feat {
    font-size: 17px;
  }
  .feat h2 {
    font-size: clamp(28px, 3vw, 40px);
  }

  /* Hero */
  .hero {
    padding: 128px 0 40px;
  }
  .hero__in {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
  }
  .crumbs {
    display: flex;
    gap: 10px;
    font-size: 13.5px;
    color: var(--dim);
  }
  .crumbs a {
    color: var(--steel);
    text-decoration: none;
  }
  .hero__for {
    display: inline-block;
    margin-top: 22px;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(139, 92, 246, 0.16);
    color: var(--violet-2);
    font-size: 13px;
    font-weight: 700;
  }
  .hero__title {
    margin-top: 16px;
    font-size: clamp(34px, 4vw, 56px);
    max-width: 14ch;
  }
  .hero__fix {
    margin-top: 14px;
    max-width: 30ch;
    font-size: clamp(21px, 1.9vw, 28px);
    font-weight: 800;
    font-variation-settings: 'wdth' 118;
    letter-spacing: -0.02em;
    line-height: 1.12;
    color: var(--violet-2);
  }
  .hero__lead {
    margin-top: 20px;
    max-width: 50ch;
    font-size: 17.5px;
    line-height: 1.6;
    color: var(--steel);
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .hero__art {
    position: relative;
    display: flex;
    justify-content: center;
  }
  .hero__art::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 55%;
    width: 110%;
    aspect-ratio: 1;
    translate: -50% -50%;
    background: radial-gradient(closest-side, rgba(139, 92, 246, 0.3), transparent 70%);
    pointer-events: none;
  }
  .hero__art--phone :global(.phone) {
    width: min(300px, 70%);
  }
  .hero__art--browser {
    display: block;
  }

  /* Facts strip */
  .facts {
    padding: 8px 0 0;
  }
  .facts__in {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }
  .facts li {
    padding: 18px 20px;
    border-radius: 14px;
    background: linear-gradient(180deg, #1f2129, #171920);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.07),
      0 0 0 1px var(--line);
  }
  .facts b {
    display: block;
    font-size: 30px;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--violet-2);
  }
  .facts span {
    display: block;
    margin-top: 6px;
    font-size: 14px;
    color: var(--steel);
  }

  /* Steps: text and screen side by side, alternating */
  .steps {
    display: grid;
    gap: clamp(40px, 6vw, 88px);
    margin: 36px 0 0;
    padding: 0;
    list-style: none;
  }
  .step {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
  }
  .step:nth-child(even) .step__text {
    order: 2;
  }
  .step__n {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--violet);
    color: #fff;
    font-size: 14px;
    font-weight: 800;
  }
  .step h3 {
    margin-top: 16px;
    font-size: clamp(22px, 2.2vw, 30px);
    line-height: 1.12;
  }
  .step p {
    margin-top: 14px;
    max-width: 48ch;
    font-size: 17px;
    line-height: 1.65;
    color: var(--steel);
  }
  .step__art {
    position: relative;
    display: flex;
    justify-content: center;
    padding: 28px;
    border-radius: 24px;
    background:
      radial-gradient(70% 70% at 50% 100%, rgba(139, 92, 246, 0.28), transparent 70%),
      linear-gradient(180deg, #1b1d24, #141518);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .step--phone .step__art :global(.phone) {
    width: min(260px, 64%);
  }
  .step--browser .step__art {
    padding: 20px;
  }

  /* Details */
  .details {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }
  .details li {
    padding: 22px 24px 24px;
    border-radius: 16px;
    background: linear-gradient(180deg, #1f2129, #171920);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.07),
      0 0 0 1px var(--line);
  }
  .details h3 {
    font-size: 19px;
    font-variation-settings: 'wdth' 108;
    letter-spacing: -0.01em;
  }
  .details p {
    margin-top: 8px;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--steel);
  }
  .limits {
    margin-top: 24px;
    padding: 20px 24px;
    border-radius: 16px;
    background: rgba(251, 191, 36, 0.07);
    box-shadow: inset 0 0 0 1px rgba(251, 191, 36, 0.25);
  }
  .limits h3 {
    font-size: 16px;
    color: var(--warn);
  }
  .limits ul {
    margin: 8px 0 0;
    padding-left: 18px;
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--steel);
  }

  /* FAQ */
  .faq__in {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: start;
  }
  details {
    border-top: 1px solid var(--line);
  }
  details:last-child {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 0;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary h3 {
    font-size: 18px;
    font-variation-settings: 'wdth' 105;
  }
  .plus {
    position: relative;
    flex: 0 0 auto;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--line-2);
  }
  .plus::before,
  .plus::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 11px;
    height: 2px;
    background: var(--chalk);
    translate: -50% -50%;
  }
  .plus::after {
    transform: rotate(90deg);
  }
  details[open] .plus::after {
    transform: none;
  }
  details p {
    padding: 0 44px 20px 0;
    font-size: 16px;
    line-height: 1.65;
    color: var(--steel);
  }

  /* Related */
  .more__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }
  .more__grid a {
    display: grid;
    gap: 6px;
    height: 100%;
    padding: 22px 24px;
    border-radius: 16px;
    background: linear-gradient(180deg, #1f2129, #171920);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.07),
      0 0 0 1px var(--line);
    text-decoration: none;
    transition: box-shadow 0.25s ease;
  }
  .more__grid a:hover {
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.07),
      0 0 0 1px rgba(196, 181, 253, 0.6);
  }
  .more__grid span {
    font-size: 13px;
    font-weight: 600;
    color: var(--violet-2);
  }
  .more__grid strong {
    font-size: 20px;
    font-weight: 800;
    font-variation-settings: 'wdth' 110;
    letter-spacing: -0.015em;
    line-height: 1.15;
  }
  .more__grid em {
    font-style: normal;
    font-size: 15px;
    color: var(--steel);
  }
  .more__cta a {
    background: rgba(139, 92, 246, 0.16);
    box-shadow: inset 0 0 0 1px rgba(196, 181, 253, 0.3);
  }

  @media (max-width: 960px) {
    .hero {
      padding-top: 108px;
    }
    .hero__in,
    .step,
    .faq__in {
      grid-template-columns: 1fr;
    }
    .step:nth-child(even) .step__text {
      order: 0;
    }
    .facts__in,
    .details,
    .more__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .hero__art--phone :global(.phone) {
      width: min(260px, 60%);
    }
  }
  @media (max-width: 600px) {
    .facts__in,
    .details,
    .more__grid {
      grid-template-columns: 1fr;
    }
    .step__art {
      padding: 20px;
    }
    .step--phone .step__art :global(.phone) {
      width: 70%;
    }
  }
</style>
