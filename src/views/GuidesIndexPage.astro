---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../site';
import { strings } from '../i18n/strings';
import { langOf, localize } from '../i18n/config';
import { liveGuides } from '../i18n/guides';
const code = langOf(Astro.url.pathname);
const t = strings(code).guidesIndex;
const index = localize('/guides/', code);
const url = new URL(index, SITE.url).href;
// The hand-built guides exist in every language; their cards come from the strings.
const pages = (
  [
    ['calories-in-indian-food', 'member'],
    ['gym-workout-plan-for-beginners', 'member'],
    ['gym-fee-reminder-message', 'owner'],
    ['gym-attendance-register', 'owner'],
  ] as const
).map(([slug, audience]) => ({ slug, ...t.pages[slug], for: audience === 'owner' ? t.owners : t.members }));
// Markdown guides live in this language (newest first), then the pages above. A guide not yet
// translated is left out rather than listed in English.
const scheduled = (await liveGuides())
  .filter((g) => g.code === code)
  .sort((a, b) => b.entry.data.publish.getTime() - a.entry.data.publish.getTime())
  .map(({ slug, entry: { data } }) => ({ slug, title: data.h1, blurb: data.blurb, for: data.audience === 'owner' ? t.owners : t.members }));
const guides = [...scheduled, ...pages];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': url,
  url,
  name: t.name,
  description: t.description,
  isPartOf: { '@id': `${SITE.url}#website` },
  hasPart: guides.map((g) => ({ '@type': 'Article', url: `${url}${g.slug}/`, headline: g.title })),
};
---

<Layout title={t.title} description={jsonLd.description} jsonLd={jsonLd}>
  <Nav />
  <main id="main" class="list">
    <div class="wrap">
      <h1 class="wide">{t.h1}</h1>
      <p class="lead">{t.lead}</p>
      <ul class="cards" role="list">
        {
          guides.map((g) => (
            <li>
              <a href={`${index}${g.slug}/`}>
                <span class="for">{g.for}</span>
                <h2>{g.title}</h2>
                <p>{g.blurb}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .list {
    padding: 128px 0 80px;
  }
  .lead {
    margin-top: 14px;
    max-width: 56ch;
    font-size: 18px;
    color: var(--steel);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 16px;
    margin-top: 36px;
    padding: 0;
    list-style: none;
  }
  .cards a {
    display: block;
    height: 100%;
    padding: 22px 24px;
    border-radius: 16px;
    background: var(--iron);
    box-shadow: inset 0 0 0 1px var(--line);
    text-decoration: none;
    transition: box-shadow 0.2s ease;
  }
  .cards a:hover {
    box-shadow: inset 0 0 0 1px rgba(196, 181, 253, 0.5);
  }
  .for {
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--violet-2);
  }
  .cards h2 {
    margin-top: 8px;
    font-size: 21px;
    color: var(--chalk);
  }
  .cards p {
    margin-top: 8px;
    color: var(--steel);
  }
  @media (max-width: 760px) {
    .list {
      padding-top: 104px;
    }
  }
</style>
