---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../site';
import { strings } from '../i18n/strings';
import { langOf, localize } from '../i18n/config';
const code = langOf(Astro.url.pathname);
const T = strings(code);
const t = T.installIphone;
const home = new URL(localize('/', code), SITE.url).href;
const url = new URL(localize('/install-iphone/', code), SITE.url).href;
const { title, description } = t;
const text = (html: string) => html.replace(/<[^>]+>/g, '').replace(/&amp;/g, '&');
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'HowTo',
      '@id': `${url}#howto`,
      name: t.quick.title,
      inLanguage: code,
      totalTime: 'PT1M',
      step: t.quick.steps.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, text: text(s) })),
    },
    { '@type': 'FAQPage', mainEntity: t.faq.map((q) => ({ '@type': 'Question', name: q.q, acceptedAnswer: { '@type': 'Answer', text: q.a } })) },
    { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'SpotAI', item: home }, { '@type': 'ListItem', position: 2, name: t.crumb, item: url }] },
  ],
};
---

<Layout title={`${title} · SpotAI`.length <= 65 ? `${title} · SpotAI` : title} description={description} jsonLd={jsonLd}>
  <Nav />
  <main id="main" class="ip">
    <div class="wrap">
      <h1 class="wide">{t.h1}</h1>
      <p class="lead">{t.lead}</p>

      <section class="ip__card ip__card--main" aria-labelledby="ip-quick">
        <h2 id="ip-quick">{t.quick.title}</h2>
        <ol class="ip__steps">
          {t.quick.steps.map((s) => <li set:html={s} />)}
        </ol>
        <a href={`/${SITE.demo.web}`} class="btn btn--primary">{t.quick.cta}</a>
      </section>

      <section class="ip__card" aria-labelledby="ip-native">
        <h2 id="ip-native">{t.native.title}</h2>
        <p class="ip__need">{t.native.need}</p>
        <ol class="ip__steps">
          {t.native.steps.map((s) => <li set:html={s} />)}
        </ol>
        <p class="ip__note">{t.native.note}</p>
      </section>

      <section class="ip__faq" aria-labelledby="ip-faq">
        <h2 id="ip-faq">{t.faqTitle}</h2>
        {t.faq.map((q) => (
          <details>
            <summary>{q.q}</summary>
            <p>{q.a}</p>
          </details>
        ))}
      </section>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .ip {
    padding: 48px 0 72px;
  }
  .ip .lead {
    max-width: 62ch;
    margin-top: 12px;
  }
  .ip__card {
    margin-top: 32px;
    padding: 24px;
    border-radius: 20px;
    background: var(--iron);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .ip__card--main {
    box-shadow: inset 0 0 0 2px var(--violet);
  }
  .ip__card h2,
  .ip__faq h2 {
    font-size: clamp(20px, 3.4vw, 26px);
  }
  .ip__steps {
    margin: 18px 0 20px;
    padding-left: 1.4em;
    display: grid;
    gap: 12px;
    line-height: 1.55;
  }
  .ip__steps :global(code) {
    font-size: 0.92em;
    overflow-wrap: anywhere;
  }
  .ip__steps :global(a) {
    color: var(--violet-2);
    text-decoration: underline;
    overflow-wrap: anywhere;
  }
  .ip__need,
  .ip__note {
    margin-top: 10px;
    color: var(--steel);
  }
  .ip__faq {
    margin-top: 40px;
    display: grid;
    gap: 10px;
  }
  .ip__faq details {
    padding: 14px 18px;
    border-radius: 14px;
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .ip__faq summary {
    cursor: pointer;
    font-weight: 700;
  }
  .ip__faq p {
    margin-top: 8px;
  }
</style>
