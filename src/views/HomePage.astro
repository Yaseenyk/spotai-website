---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Members from '../components/Members.astro';
import Coach from '../components/Coach.astro';
import Gains from '../components/Gains.astro';
import Owners from '../components/Owners.astro';
import Privacy from '../components/Privacy.astro';
import Faq from '../components/Faq.astro';
import Download from '../components/Download.astro';
import Footer from '../components/Footer.astro';
import { strings } from '../i18n/strings';
import { langOf } from '../i18n/config';
const t = strings(langOf(Astro.url.pathname));
---

<Layout title={t.home.title}>
  <Nav />
  <main id="main">
    <Hero />
    <Members />
    <Coach />
    <Gains />
    <Owners />
    <Privacy />
    <Faq />
    <Download />
  </main>
  <Footer />
  <script>
    // Content is plain HTML and the first screen paints without any of this. All client animation (the
    // exercise reel and the scroll-driven squat; no animation library) arrives in ONE dynamic import, at the first user interaction or 5 s after
    // load, whichever comes first, so nothing competes with first paint or first input.
    let started = false;
    const boot = () => {
      if (started) return;
      started = true;
      for (const ev of ['pointerdown', 'keydown', 'scroll', 'touchstart']) window.removeEventListener(ev, boot);
      import('../motion').then((m) => m.start());
    };
    for (const ev of ['pointerdown', 'keydown', 'scroll', 'touchstart']) window.addEventListener(ev, boot, { once: true, passive: true });
    const later = () => setTimeout(boot, 5000);
    if (document.readyState === 'complete') later();
    else window.addEventListener('load', later, { once: true });
  </script>
</Layout>
