---
import '../styles/global.css';
import { SITE, FAQ } from '../site';

interface Props {
  noindex?: boolean;
  title?: string;
  description?: string;
  jsonLd?: unknown;
}
const { title = `${SITE.name} — ${SITE.tagline}`, description = SITE.description, jsonLd: pageLd, noindex = false } = Astro.props;
const pageGraph = (pageLd as { '@graph'?: unknown[]; '@type'?: string } | undefined)?.['@graph'] ?? (pageLd ? [pageLd] : []);
const pageHasFaq = pageGraph.some((n) => (n as { '@type'?: string })['@type'] === 'FAQPage');
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = `${SITE.url}og/cover.png`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE.url}#org`,
      name: SITE.name,
      url: SITE.url,
      logo: `${SITE.url}icon.svg`,
      email: SITE.email,
      founder: { '@type': 'Person', name: SITE.author.name, url: SITE.author.url },
      description: SITE.description,
      areaServed: 'IN',
      address: { '@type': 'PostalAddress', addressLocality: 'Hyderabad', addressRegion: 'Telangana', addressCountry: 'IN' },
      sameAs: ['https://github.com/Yaseenyk/spotai-website', SITE.author.url],
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}#website`,
      url: SITE.url,
      name: SITE.name,
      description: SITE.description,
      inLanguage: 'en-IN',
      publisher: { '@id': `${SITE.url}#org` },
    },
    {
      '@type': 'FAQPage',
      '@id': `${SITE.url}#faq`,
      mainEntity: FAQ.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author.name} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" href={`${base}icon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    <meta name="theme-color" content="#05070a" />
    <meta name="color-scheme" content="dark" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SpotAI: your AI gym buddy, with the member app and the owner dashboard" />
    <meta name="twitter:card" content={SITE.twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&display=swap"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [...jsonLd['@graph'].filter((n) => !(pageHasFaq && n['@type'] === 'FAQPage')), ...pageGraph],
      })}
    />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
    <a class="wa" href={`https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent('Hi SpotAI, I want to know about the free pilot for my gym.')}`} target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
      <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.6.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.1.6a2.6 2.6 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.2c0-.1-.2-.2-.4-.3z"/></svg>
      <span>WhatsApp</span>
    </a>
    <style>
      .skip {
        position: absolute;
        left: 16px;
        top: -60px;
        z-index: 200;
        padding: 10px 16px;
        border-radius: 999px;
        background: var(--text);
        color: var(--ink);
        font-weight: 700;
        text-decoration: none;
      }
      .wa {
        position: fixed;
        right: 18px;
        bottom: 18px;
        z-index: 60;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 16px 10px 12px;
        border-radius: 999px;
        background: #25d366;
        color: #06240f;
        font-weight: 700;
        font-size: 14px;
        text-decoration: none;
        box-shadow: 0 10px 30px -10px rgba(37, 211, 102, 0.7);
      }
      @media (max-width: 600px) {
        .wa span {
          display: none;
        }
        .wa {
          padding: 12px;
        }
      }
      .skip:focus {
        top: 16px;
      }
    </style>
  </body>
</html>
