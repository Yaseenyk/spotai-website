---
import '../styles/global.css';
import { SITE, FAQ } from '../site';

interface Props {
  title?: string;
  description?: string;
}
const { title = `${SITE.name} — ${SITE.tagline}`, description = SITE.description } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = `${SITE.url}og/cover.png`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE.url}#org`,
      name: SITE.name,
      url: SITE.url,
      logo: `${SITE.url}icon.svg`,
      email: SITE.email,
      founder: { '@type': 'Person', name: SITE.author.name, url: SITE.author.url },
      areaServed: 'IN',
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}#website`,
      url: SITE.url,
      name: SITE.name,
      description: SITE.description,
      inLanguage: 'en-IN',
      publisher: { '@id': `${SITE.url}#org` },
    },
    {
      '@type': 'MobileApplication',
      '@id': `${SITE.url}#app`,
      name: SITE.name,
      description: SITE.description,
      applicationCategory: 'HealthApplication',
      operatingSystem: 'Android, iOS',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR', availability: 'https://schema.org/PreOrder' },
      featureList: [
        'On-device AI form check for squats',
        'Workout plan, exercise library with short videos, set logging',
        'Opt-in gym leaderboard: visits, kilograms, streak',
        'Buddy matching, chat and training groups',
        'QR and optional face check-in',
        'Membership, dues and UPI payments',
        'Consent per purpose, data export and deletion',
      ],
      author: { '@id': `${SITE.url}#org` },
      screenshot: og,
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${SITE.url}#owner`,
      name: `${SITE.name} for Gym Owners`,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web',
      description:
        'Owner dashboard and staff consoles for Indian gyms: arrivals with dues flags, revenue, busy hours, members, plans, dues reminders, complaints, trainer review queue and front-desk check-in.',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR', availability: 'https://schema.org/PreOrder' },
      author: { '@id': `${SITE.url}#org` },
    },
    {
      '@type': 'FAQPage',
      '@id': `${SITE.url}#faq`,
      mainEntity: FAQ.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={SITE.keywords.join(', ')} />
    <meta name="author" content={SITE.author.name} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}icon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    <meta name="theme-color" content="#05070a" />
    <meta name="color-scheme" content="dark" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SpotAI: your AI gym buddy, with the member app and the owner dashboard" />
    <meta name="twitter:card" content={SITE.twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;600&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
    <style>
      .skip {
        position: absolute;
        left: 16px;
        top: -60px;
        z-index: 200;
        padding: 10px 16px;
        border-radius: 999px;
        background: var(--text);
        color: var(--ink);
        font-weight: 700;
        text-decoration: none;
      }
      .skip:focus {
        top: 16px;
      }
    </style>
  </body>
</html>
