---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { FEATURES, feature } from '../../features';
import { SITE } from '../../site';

export function getStaticPaths() {
  return FEATURES.map((f) => ({ params: { slug: f.slug } }));
}
const { slug } = Astro.params;
const f = feature(slug!);
const base = import.meta.env.BASE_URL;
const url = `${SITE.url}features/${f.slug}/`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': url,
      url,
      name: f.title,
      description: f.description,
      isPartOf: { '@id': `${SITE.url}#website` },
      about: { '@id': `${SITE.url}#app` },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'SpotAI', item: SITE.url },
        { '@type': 'ListItem', position: 2, name: f.nav, item: url },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: f.faq.map((q) => ({ '@type': 'Question', name: q.q, acceptedAnswer: { '@type': 'Answer', text: q.a } })),
    },
  ],
};
const who = { members: 'For members', owners: 'For gym owners', everyone: 'For members and gym owners' }[f.audience];
---

<Layout title={`${f.title} · SpotAI`} description={f.description} jsonLd={jsonLd}>
  <Nav />
  <main id="main" class="feat">
    <section class="feat__hero">
      <div class="wrap">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href={base}>SpotAI</a><span aria-hidden="true">/</span><span>{f.nav}</span>
        </nav>
        <p class="feat__for">{who}</p>
        <h1 class="feat__title wide">{f.problem}</h1>
        <p class="feat__fix">{f.fix}</p>
        <p class="lead">{f.lead}</p>
        <div class="feat__cta">
          <a href={`${base}#download`} class="btn btn--primary">Get early access</a>
          <a href={`${base}#faq`} class="btn btn--ghost">Questions</a>
        </div>
      </div>
    </section>

    <section class="feat__shots" aria-label="Screens">
      <div class="wrap">
        <ul class:list={['shots', `shots--${f.shots[0]!.kind}`]} role="list">
          {
            f.shots.map((s) =>
              s.kind === 'phone' ? (
                <li class="shots__phone">
                  <div class="phone">
                    <img src={`${base}shots/${s.src}`} width="640" height="1385" alt={s.alt} loading="lazy" decoding="async" />
                  </div>
                </li>
              ) : (
                <li class="shots__browser">
                  <div class="browser">
                    <div class="browser__bar" aria-hidden="true"><i></i><i></i><i></i><span>owner.spotai.app</span></div>
                    <img src={`${base}shots/${s.src}`} width="1600" height="1000" alt={s.alt} loading="lazy" decoding="async" />
                  </div>
                </li>
              ),
            )
          }
        </ul>
      </div>
    </section>

    <section class="section feat__how" aria-labelledby="how">
      <div class="wrap">
        <h2 id="how">How it works</h2>
        <ol class="steps" role="list">
          {
            f.steps.map((s, i) => (
              <li>
                <span class="steps__n" aria-hidden="true">{i + 1}</span>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="section feat__details" aria-labelledby="details">
      <div class="wrap">
        <h2 id="details">What you get</h2>
        <ul class="details" role="list">
          {
            f.details.map((d) => (
              <li>
                <h3>{d.title}</h3>
                <p>{d.body}</p>
              </li>
            ))
          }
        </ul>
        <div class="limits">
          <h3>Today’s limits</h3>
          <ul>{f.limits.map((l) => <li>{l}</li>)}</ul>
        </div>
      </div>
    </section>

    <section class="section feat__faq" aria-labelledby="ffaq">
      <div class="wrap feat__faq-in">
        <h2 id="ffaq">Questions</h2>
        <div>
          {
            f.faq.map((q, i) => (
              <details open={i === 0}>
                <summary>
                  <h3>{q.q}</h3>
                  <span class="plus" aria-hidden="true" />
                </summary>
                <p>{q.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section feat__more" aria-labelledby="more">
      <div class="wrap">
        <h2 id="more">More of SpotAI</h2>
        <ul class="more" role="list">
          {
            f.related.map((r) => {
              const o = feature(r);
              return (
                <li>
                  <a href={`${base}features/${o.slug}/`}>
                    <span>{o.nav}</span>
                    <strong>{o.problem}</strong>
                    <em>{o.fix}</em>
                  </a>
                </li>
              );
            })
          }
          <li class="more__cta">
            <a href={`${base}#download`}>
              <span>Get the app</span>
              <strong>Join the waitlist</strong>
              <em>Play Store and App Store links on launch day.</em>
            </a>
          </li>
        </ul>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .feat__hero {
    padding: 136px 0 32px;
  }
  .crumbs {
    display: flex;
    gap: 10px;
    font-size: 13.5px;
    color: var(--dim);
  }
  .crumbs a {
    color: var(--steel);
    text-decoration: none;
  }
  .feat__for {
    display: inline-block;
    margin-top: 22px;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(139, 92, 246, 0.16);
    color: var(--violet-2);
    font-size: 13px;
    font-weight: 700;
  }
  .feat__title {
    margin-top: 16px;
    font-size: clamp(34px, 4.2vw, 60px);
    max-width: 16ch;
  }
  .feat__fix {
    margin-top: 14px;
    max-width: 30ch;
    font-size: clamp(22px, 2vw, 30px);
    font-weight: 800;
    font-variation-settings: 'wdth' 118;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--violet-2);
  }
  .feat__hero .lead {
    margin-top: 20px;
  }
  .feat__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .feat__shots {
    padding: 24px 0 0;
    overflow: hidden;
  }
  .shots {
    display: flex;
    gap: 20px;
    justify-content: center;
    align-items: flex-start;
    margin: 0;
    padding: 36px 0 0;
    list-style: none;
    position: relative;
  }
  .shots::before {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 90%;
    height: 70%;
    translate: -50% 0;
    background: radial-gradient(55% 60% at 50% 100%, rgba(139, 92, 246, 0.35), transparent 70%);
    pointer-events: none;
  }
  .shots__phone {
    flex: 0 0 auto;
    width: min(250px, 28%);
  }
  .shots--phone .shots__phone:nth-child(2) {
    translate: 0 -24px;
  }
  .shots__browser {
    flex: 1 1 0;
    min-width: 0;
    max-width: 560px;
  }
  /* Console screens are mostly empty below the fold: a fixed window zoomed to the top-left content. */
  .browser {
    border-radius: 12px;
    background: #e9eaef;
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.5),
      0 40px 70px -40px rgba(0, 0, 0, 0.95);
    overflow: hidden;
  }
  .browser img {
    width: 150%;
    max-width: none;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: 0 0;
  }
  .shots--browser .browser img,
  .shots--phone .browser img {
    aspect-ratio: auto;
    height: auto;
  }
  .shots__browser .browser {
    aspect-ratio: 16 / 11;
  }
  .browser__bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 10px;
    background: #dcdde3;
  }
  .browser__bar i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #b7b9c2;
  }
  .browser__bar span {
    margin-left: 8px;
    padding: 2px 10px;
    border-radius: 6px;
    background: #fff;
    font-size: 10px;
    color: #6b7080;
  }
  .shots--browser {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .shots--browser .shots__browser {
    max-width: none;
  }
  .shots--browser .shots__phone {
    width: auto;
    justify-self: center;
    max-width: 250px;
  }

  .feat h2 {
    font-size: clamp(26px, 2.8vw, 36px);
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }
  .steps li {
    padding: 20px 22px 22px;
    border-radius: 16px;
    background: linear-gradient(180deg, #1f2129, #171920);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.07),
      0 0 0 1px var(--line);
  }
  .steps__n {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--violet);
    color: #fff;
    font-size: 13px;
    font-weight: 800;
  }
  .steps h3,
  .details h3 {
    margin-top: 12px;
    font-size: 17px;
    font-variation-settings: 'wdth' 105;
    letter-spacing: -0.01em;
  }
  .steps p,
  .details p {
    margin-top: 6px;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--steel);
  }
  .details {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 28px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }
  .details li {
    padding: 16px 0 18px;
    border-top: 1px solid var(--line);
  }
  .details h3 {
    margin-top: 0;
  }
  .limits {
    margin-top: 28px;
    padding: 18px 22px;
    border-radius: 14px;
    background: rgba(251, 191, 36, 0.07);
    box-shadow: inset 0 0 0 1px rgba(251, 191, 36, 0.25);
  }
  .limits h3 {
    font-size: 15px;
    color: var(--warn);
  }
  .limits ul {
    margin: 8px 0 0;
    padding-left: 18px;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--steel);
  }

  .feat__faq-in {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: start;
  }
  details {
    border-top: 1px solid var(--line);
  }
  details:last-child {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 0;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary h3 {
    font-size: 17px;
    font-variation-settings: 'wdth' 105;
  }
  .plus {
    position: relative;
    flex: 0 0 auto;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--line-2);
  }
  .plus::before,
  .plus::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 11px;
    height: 2px;
    background: var(--chalk);
    translate: -50% -50%;
  }
  .plus::after {
    transform: rotate(90deg);
  }
  details[open] .plus::after {
    transform: none;
  }
  details p {
    padding: 0 44px 18px 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--steel);
  }

  .more {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }
  .more a {
    display: grid;
    gap: 6px;
    height: 100%;
    padding: 20px 22px;
    border-radius: 16px;
    background: linear-gradient(180deg, #1f2129, #171920);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.07),
      0 0 0 1px var(--line);
    text-decoration: none;
    transition: box-shadow 0.25s ease;
  }
  .more a:hover {
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.07),
      0 0 0 1px rgba(196, 181, 253, 0.6);
  }
  .more span {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--violet-2);
  }
  .more strong {
    font-size: 19px;
    font-weight: 800;
    font-variation-settings: 'wdth' 110;
    letter-spacing: -0.015em;
    line-height: 1.15;
  }
  .more em {
    font-style: normal;
    font-size: 14px;
    color: var(--steel);
  }
  .more__cta a {
    background: rgba(139, 92, 246, 0.16);
    box-shadow: inset 0 0 0 1px rgba(196, 181, 253, 0.3);
  }

  @media (max-width: 960px) {
    .feat__hero {
      padding-top: 112px;
    }
    .steps,
    .details,
    .more {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .feat__faq-in,
    .shots--browser {
      grid-template-columns: 1fr;
    }
    .shots__phone {
      width: min(220px, 30%);
    }
  }
  @media (max-width: 600px) {
    .steps,
    .details,
    .more {
      grid-template-columns: 1fr;
    }
    .shots {
      flex-wrap: wrap;
    }
    .shots__phone {
      width: 44%;
    }
    .shots--phone .shots__phone:nth-child(2) {
      translate: none;
    }
  }
</style>
