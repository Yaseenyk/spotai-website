---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../site';

const base = import.meta.env.BASE_URL;
const url = `${SITE.url}pricing/`;
const wa = `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(`Hi SpotAI, I run a gym in ${SITE.pilot.city} and want the free pilot.`)}`;
const title = 'Gym management software price in India: SpotAI free pilot';
const description = `SpotAI is free for the first ${SITE.pilot.gyms} gyms in ${SITE.pilot.city} for ${SITE.pilot.days} days. Free for members. No per-member fee planned.`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebPage', '@id': url, url, name: title, description, isPartOf: { '@id': `${SITE.url}#website` } },
    { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'SpotAI', item: SITE.url }, { '@type': 'ListItem', position: 2, name: 'Pricing', item: url }] },
  ],
};
---

<Layout title={`${title} · SpotAI`} description={description} jsonLd={jsonLd}>
  <Nav />
  <main id="main" class="pr">
    <div class="wrap">
      <h1 class="wide">Pricing</h1>
      <p class="lead">Nothing to pay during the pilot. Pricing after it is announced to pilot gyms first.</p>

      <div class="plans">
        <section class="plan plan--gym" aria-labelledby="plan-gym">
          <p class="plan__for">Gym owners</p>
          <h2 id="plan-gym"><span class="plan__price">₹0</span> for {SITE.pilot.days} days</h2>
          <p class="plan__sub">First {SITE.pilot.gyms} gyms in {SITE.pilot.city}</p>
          <ul>
            <li>Owner console, front-desk console, trainer console</li>
            <li>We load your register or Excel in one visit</li>
            <li>QR poster for the desk, app poster for the floor</li>
            <li>WhatsApp support, seven days a week</li>
            <li>Your member list stays yours</li>
            <li>No per-member fee planned after the pilot</li>
          </ul>
          <a href={wa} target="_blank" rel="noopener" class="btn btn--primary">Chat on WhatsApp</a>
          <a href={`${base}for-gym-owners/`} class="plan__link">What the pilot includes</a>
        </section>

        <section class="plan" aria-labelledby="plan-member">
          <p class="plan__for">Members</p>
          <h2 id="plan-member"><span class="plan__price">Free</span></h2>
          <p class="plan__sub">When your gym is on SpotAI</p>
          <ul>
            <li>AI squat coach on your phone camera</li>
            <li>Today’s workout and every set logged</li>
            <li>Your gym’s leaderboard and buddies</li>
            <li>Membership, days left and UPI dues in the app</li>
            <li>Export or delete your data any time</li>
          </ul>
          <a href={`https://wa.me/?text=${encodeURIComponent('Bhaiya, can we get SpotAI at our gym? Free pilot for Hyderabad gyms: https://spotai.streamerosai.com/for-gym-owners/')}`} target="_blank" rel="noopener" class="btn btn--ghost">Ask your gym to switch it on</a>
        </section>
      </div>

      <section class="notes" aria-labelledby="notes-title">
        <h2 id="notes-title">What is and is not in the pilot</h2>
        <ul>
          <li>Dues reminders and UPI payments run in demo mode during the pilot: the flows are in the app, nothing is sent or charged until we switch your gym to live with you.</li>
          <li>The AI coach checks squats today. Deadlift and bench press are next.</li>
          <li>Face check-in hardware is optional and comes later; QR and check-in by name work from day one.</li>
          <li>Your gym remains the data fiduciary for its members under India’s DPDP Act; SpotAI gives you the consent records, exports and complaint references to meet it.</li>
        </ul>
      </section>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .pr {
    padding: 128px 0 80px;
    font-size: 17px;
  }
  .pr h1 {
    font-size: clamp(34px, 4vw, 56px);
  }
  .pr .lead {
    margin-top: 14px;
    font-size: 18px;
  }
  .plans {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin-top: 40px;
  }
  .plan {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 28px;
    border-radius: 20px;
    background: linear-gradient(180deg, #1f2129, #171920);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.07),
      0 0 0 1px var(--line);
  }
  .plan--gym {
    background: rgba(139, 92, 246, 0.14);
    box-shadow: inset 0 0 0 1px rgba(196, 181, 253, 0.35);
  }
  .plan__for {
    font-size: 13px;
    font-weight: 700;
    color: var(--violet-2);
  }
  .plan h2 {
    font-size: 24px;
  }
  .plan__price {
    font-size: 44px;
    font-variation-settings: 'wdth' 118;
    letter-spacing: -0.03em;
  }
  .plan__sub {
    color: var(--steel);
  }
  .plan ul {
    margin: 8px 0 12px;
    padding-left: 20px;
    line-height: 1.7;
    color: var(--steel);
  }
  .plan .btn {
    justify-self: start;
  }
  .plan__link {
    font-size: 14px;
    color: var(--violet-2);
  }
  .notes {
    margin-top: 48px;
    padding: 24px 28px;
    border-radius: 16px;
    background: rgba(251, 191, 36, 0.07);
    box-shadow: inset 0 0 0 1px rgba(251, 191, 36, 0.25);
  }
  .notes h2 {
    font-size: 20px;
    color: var(--warn);
  }
  .notes ul {
    margin: 10px 0 0;
    padding-left: 20px;
    line-height: 1.65;
    color: var(--steel);
  }
  @media (max-width: 760px) {
    .plans {
      grid-template-columns: 1fr;
    }
    .pr {
      padding-top: 108px;
    }
  }
</style>
