---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { SITE } from '../../site';

const base = import.meta.env.BASE_URL;
const url = `${SITE.url}guides/`;
const guides = [
  { slug: 'calories-in-indian-food', title: 'Calories in roti, rice, dal and other Indian food', blurb: 'One roti, one idli, a bowl of dal: calories and protein per serving for everyday Indian dishes.', for: 'Members' },
  { slug: 'gym-workout-plan-for-beginners', title: 'Gym workout plan for beginners', blurb: 'A 3-day full body plan and a 4-day upper/lower split, with sets, reps and how to progress.', for: 'Members' },
  { slug: 'gym-fee-reminder-message', title: 'Gym fee reminder message templates', blurb: 'Ready-to-send WhatsApp reminders in English and Hindi, before, on and after the due date.', for: 'Gym owners' },
  { slug: 'gym-attendance-register', title: 'Gym attendance register: free sheet', blurb: 'A free attendance sheet for Excel or Google Sheets, and three checks that keep members renewing.', for: 'Gym owners' },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': url,
  url,
  name: 'SpotAI guides',
  description: 'Practical guides for gym members and gym owners in India: calories in Indian food, beginner workout plans, fee reminder messages and attendance registers.',
  isPartOf: { '@id': `${SITE.url}#website` },
  hasPart: guides.map((g) => ({ '@type': 'Article', url: `${url}${g.slug}/`, headline: g.title })),
};
---

<Layout title="Gym guides for members and owners in India · SpotAI" description={jsonLd.description} jsonLd={jsonLd}>
  <Nav />
  <main id="main" class="list">
    <div class="wrap">
      <h1 class="wide">Guides</h1>
      <p class="lead">Short, practical answers for people who train and people who run gyms in India.</p>
      <ul class="cards" role="list">
        {
          guides.map((g) => (
            <li>
              <a href={`${base}guides/${g.slug}/`}>
                <span class="for">{g.for}</span>
                <h2>{g.title}</h2>
                <p>{g.blurb}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .list {
    padding: 128px 0 80px;
  }
  .lead {
    margin-top: 14px;
    max-width: 56ch;
    font-size: 18px;
    color: var(--steel);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 16px;
    margin-top: 36px;
    padding: 0;
    list-style: none;
  }
  .cards a {
    display: block;
    height: 100%;
    padding: 22px 24px;
    border-radius: 16px;
    background: var(--iron);
    box-shadow: inset 0 0 0 1px var(--line);
    text-decoration: none;
    transition: box-shadow 0.2s ease;
  }
  .cards a:hover {
    box-shadow: inset 0 0 0 1px rgba(196, 181, 253, 0.5);
  }
  .for {
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--violet-2);
  }
  .cards h2 {
    margin-top: 8px;
    font-size: 21px;
    color: var(--chalk);
  }
  .cards p {
    margin-top: 8px;
    color: var(--steel);
  }
  @media (max-width: 760px) {
    .list {
      padding-top: 104px;
    }
  }
</style>
