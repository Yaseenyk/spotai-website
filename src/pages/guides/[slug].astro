---
import GuidePage from '../../views/GuidePage.astro';
import { langsBySlug, liveGuides } from '../../i18n/guides';
// One page per English Markdown guide whose publish date has passed at build time.
export async function getStaticPaths() {
  const guides = await liveGuides();
  const langs = langsBySlug(guides);
  return guides
    .filter((g) => g.code === 'en')
    .map((g) => ({ params: { slug: g.slug }, props: { guide: g.entry, slug: g.slug, langs: langs.get(g.slug)! } }));
}
---

<GuidePage {...Astro.props} />
