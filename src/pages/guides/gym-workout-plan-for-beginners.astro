---
import GuideLayout from '../../components/GuideLayout.astro';

const base = import.meta.env.BASE_URL;
const fullBody = [
  ['Day 1', 'Goblet squat 3×10 · Push-up 3×8 · Dumbbell row 3×10 · Plank 3×30 s'],
  ['Day 2', 'Romanian deadlift 3×10 · Dumbbell shoulder press 3×10 · Lat pulldown 3×10 · Glute bridge 3×12'],
  ['Day 3', 'Leg press 3×12 · Dumbbell bench press 3×10 · Seated cable row 3×10 · Dead bug 3×10'],
];
const upperLower = [
  ['Mon: Upper', 'Dumbbell bench press · Lat pulldown · Shoulder press · Dumbbell row · Biceps curl'],
  ['Tue: Lower', 'Goblet squat · Romanian deadlift · Walking lunge · Calf raise · Plank'],
  ['Thu: Upper', 'Incline push-up · Seated cable row · Lateral raise · Face pull · Triceps pushdown'],
  ['Fri: Lower', 'Leg press · Hip thrust · Leg curl · Step-up · Side plank'],
];
const faq = [
  {
    q: 'How many days a week should a beginner go to the gym?',
    a: 'Three days a week is enough to start, with a rest day between sessions. Moving to four days with an upper/lower split works well once three days feels easy.',
  },
  {
    q: 'Is a bro split (one muscle a day) good for beginners?',
    a: 'It works, but it trains each muscle only once a week. Full body or upper/lower hits each muscle about twice a week, which is the common recommendation for building muscle.',
  },
  {
    q: 'How many sets and reps should a beginner do?',
    a: 'Two to three sets of 8 to 12 reps per exercise, stopping with one or two good reps left. Add weight when you can do the top of the range on every set with clean form.',
  },
  {
    q: 'Can an app plan my gym workout?',
    a: "SpotAI suggests today's session from what you trained in the last week, so each muscle comes round about twice a week, and logs every set. You can always pick something else.",
  },
];
---

<GuideLayout
  slug="gym-workout-plan-for-beginners"
  title="Gym workout plan for beginners: 3-day and 4-day split · SpotAI"
  description="A simple gym workout plan for beginners: a 3-day full body plan and a 4-day upper/lower split, with sets, reps and how to progress. Each muscle about twice a week."
  h1="Gym workout plan for beginners"
  answer="Start with three full-body days a week (for example Monday, Wednesday, Friday), 2 to 3 sets of 8 to 12 reps per exercise. After a couple of months, move to a 4-day upper/lower split. Both train each muscle about twice a week, which works better for beginners than one muscle a day."
  updated="2026-11-02"
  faq={faq}
  cta={{ label: 'How SpotAI plans your day', href: `${base}features/workouts/`, text: "SpotAI picks today's session from your last week and logs every set, with a short video for every exercise." }}
>
  <h2>3-day full body plan</h2>
  <p>Train on three non-consecutive days. Rest at least a day between sessions.</p>
  <div class="table-wrap">
    <table>
      <thead><tr><th scope="col">Day</th><th scope="col" style="text-align:left">Exercises</th></tr></thead>
      <tbody>{fullBody.map(([d, e]) => <tr><td>{d}</td><td style="text-align:left;white-space:normal">{e}</td></tr>)}</tbody>
    </table>
  </div>

  <h2>4-day upper/lower split</h2>
  <p>When three days feels easy, split the body in two and train each half twice: for example Monday, Tuesday, Thursday, Friday. Do 3 sets of 8 to 12 reps.</p>
  <div class="table-wrap">
    <table>
      <thead><tr><th scope="col">Day</th><th scope="col" style="text-align:left">Exercises</th></tr></thead>
      <tbody>{upperLower.map(([d, e]) => <tr><td>{d}</td><td style="text-align:left;white-space:normal">{e}</td></tr>)}</tbody>
    </table>
  </div>

  <h2>How to progress</h2>
  <ul>
    <li><strong>Write every set down.</strong> Reps and kilograms. Without a log you can't tell if you are getting stronger.</li>
    <li><strong>Add weight slowly.</strong> When every set reaches 12 clean reps, go up by the smallest jump the gym has.</li>
    <li><strong>Form first.</strong> If your knees cave in on squats or your back rounds on deadlifts, lower the weight. Ask the trainer, or let the SpotAI coach check your squat on the phone camera.</li>
    <li><strong>Rest days count.</strong> Sleep and food are when the training turns into muscle.</li>
  </ul>
  <p class="note">General guidance for healthy adults, not medical advice. Check with a doctor before starting if you have an injury or health condition, and with your gym's trainer for your own plan.</p>
</GuideLayout>
