---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Screen from '../components/Screen.astro';
import { SITE } from '../site';

const base = import.meta.env.BASE_URL;
const url = `${SITE.url}for-gym-owners/`;
const wa = (t: string) => `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(t)}`;
const pilotMsg = `Hi SpotAI, I run a gym in ${SITE.pilot.city} and want the free pilot.`;
const title = 'Gym management software for Indian gyms, free pilot in Hyderabad';
const description = `See who came today, who stopped coming and who owes, from one screen. Free ${SITE.pilot.days}-day pilot for the first ${SITE.pilot.gyms} gyms in ${SITE.pilot.city}; members need no app to start.`;
const faq = [
  { q: 'How much does it cost?', a: `Free for the first ${SITE.pilot.gyms} gyms in ${SITE.pilot.city} for ${SITE.pilot.days} days. Pricing after the pilot is announced to pilot gyms first; there is no per-member fee planned.` },
  { q: 'Do my members have to install an app?', a: 'No. The front desk checks members in by QR or by name and tracks dues without anyone installing anything. Members install the app when they want the AI coach, leaderboard, buddies or in-app payments.' },
  { q: 'What do I need at the gym?', a: 'A laptop or phone with internet for the console. Any Android phone for members who want the app. The face check-in device is optional and comes later.' },
  { q: 'What happens to my register or Excel?', a: 'We load it for you in one visit: names, plans, end dates, dues. You keep working from the console from day one.' },
  { q: 'Does it replace my trainer?', a: 'No. Every tip the AI coach gives is a template your trainer approved in the trainer console, and trainers see which tips members marked wrong.' },
  { q: 'Who owns the data?', a: 'You own your member list. Members own their own data and can export or delete it from the app. Camera video never leaves their phone.' },
  { q: 'Do dues reminders and UPI work today?', a: 'In the pilot, reminders and UPI run in demo mode: the flows are in the app, nothing is sent or charged until we switch your gym to live with you.' },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebPage', '@id': url, url, name: title, description, isPartOf: { '@id': `${SITE.url}#website` }, about: { '@id': `${SITE.url}#owner` } },
    { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'SpotAI', item: SITE.url }, { '@type': 'ListItem', position: 2, name: 'For gym owners', item: url }] },
    { '@type': 'FAQPage', mainEntity: faq.map((q) => ({ '@type': 'Question', name: q.q, acceptedAnswer: { '@type': 'Answer', text: q.a } })) },
  ],
};
const today = [
  ['Who came today', 'Arrivals as they happen, with the time and how they checked in. Dues flagged on the name for the front desk.'],
  ['Who stopped coming', 'Visits per member, last visit, and the busy-hours heatmap. The member who vanished in week three shows up before the month ends.'],
  ['Who owes', 'Overdue list with amount and days late. Members never see each other’s dues.'],
  ['What the floor looks like', 'Daily visits for 14 days, busy hours over four weeks, memberships ending this week, collected this month against last.'],
];
const compare = [
  ['Who came today', 'Ask the desk', 'Live list'],
  ['Who stopped coming', 'Notice at renewal', 'Flagged after 7 days'],
  ['Dues', 'WhatsApp screenshots', 'List with days late, UPI in the app'],
  ['Member list', 'One register, one copy', 'Console, searchable, always yours'],
  ['Busy hours', 'Gut feel', 'Four-week heatmap'],
  ['Trainer tips', 'Verbal', 'Approved templates, wrong-rate tracked'],
];
---

<Layout title={`${title} · SpotAI`} description={description} jsonLd={jsonLd}>
  <Nav />
  <main id="main" class="own">
    <section class="hero">
      <div class="wrap hero__in">
        <div>
          <p class="hero__for">For gym owners · {SITE.pilot.city}</p>
          <h1 class="wide">Gym management software that shows who came, who stopped coming and who owes.</h1>
          <p class="hero__fix">See it before they stop paying.</p>
          <p class="hero__lead">
            SpotAI’s owner console is a live picture of your floor on your laptop or phone. Members need no app to start:
            the front desk checks them in by QR or by name. Members who want the AI coach, the leaderboard and buddies
            install the app when they are ready.
          </p>
          <div class="hero__cta">
            <a href={wa(pilotMsg)} target="_blank" rel="noopener" class="btn btn--primary">Chat on WhatsApp</a>
            <a href="#pilot" class="btn btn--ghost">The free pilot</a>
          </div>
          <p class="hero__note">Free {SITE.pilot.days}-day pilot for the first {SITE.pilot.gyms} gyms in {SITE.pilot.city}. We load your register for you.</p>
        </div>
        <div class="hero__art">
          <Screen shot={{ kind: 'browser', src: 'o-overview.webp', alt: 'SpotAI owner console: arrivals today, active members, overdue, collected this month, daily visits, busy hours and live arrivals' }} eager />
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="today-title">
      <div class="wrap">
        <h2 id="today-title">One screen, every morning</h2>
        <ul class="grid4" role="list">
          {today.map(([t, b]) => (<li><h3>{t}</h3><p>{b}</p></li>))}
        </ul>
      </div>
    </section>

    <section class="section" aria-labelledby="vs-title">
      <div class="wrap">
        <h2 id="vs-title">Against the register, Excel and the WhatsApp group</h2>
        <table class="vs">
          <thead><tr><th scope="col"></th><th scope="col">Today</th><th scope="col">With SpotAI</th></tr></thead>
          <tbody>
            {compare.map(([k, a, b]) => (<tr><th scope="row">{k}</th><td>{a}</td><td>{b}</td></tr>))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section" aria-labelledby="shots-title">
      <div class="wrap">
        <h2 id="shots-title">The console</h2>
        <ul class="shots" role="list">
          <li><Screen shot={{ kind: 'browser', src: 'o-dues.webp', alt: 'Dues: overdue members with amount, days late, last visit and Send reminder' }} /><p>Dues, with days late and a reminder button that respects each member’s consent.</p></li>
          <li><Screen shot={{ kind: 'browser', src: 'o-insights.webp', alt: 'Insights: members who visited, came back, visits per week, members using the AI coach, visits by weekday' }} /><p>Insights for the last 30 days. Anything from fewer than five members is hidden.</p></li>
          <li><Screen shot={{ kind: 'browser', src: 'o-members.webp', alt: 'Members list with plan and status' }} /><p>Members, plans, check-in history, complaints with their reference number.</p></li>
        </ul>
        <a class="more-link" href={`${base}features/owners/`}>Every owner feature, in detail</a>
      </div>
    </section>

    <section class="section" aria-labelledby="members-title">
      <div class="wrap two">
        <div>
          <h2 id="members-title">What your members get, when they are ready</h2>
          <p class="lead">A reason to keep coming, which is what keeps dues paid.</p>
          <ul class="list">
            <li><strong>AI squat coach</strong> on their own phone camera. Every tip is a template your trainer approved.</li>
            <li><strong>Today’s workout</strong> and every set logged, with a short for every exercise.</li>
            <li><strong>Your gym’s leaderboard</strong>: visits, kilos, streak. Opt-in, first names only.</li>
            <li><strong>Buddies</strong> who train at the same hours. Adults only, trainer-moderated.</li>
            <li><strong>Membership and dues</strong> on the home screen, UPI in the app.</li>
          </ul>
          <a class="more-link" href={`${base}features/`}>All member features</a>
        </div>
        <div class="hero__art hero__art--phone">
          <Screen shot={{ kind: 'phone', src: 'm-dark-home-train.webp', alt: 'SpotAI member app home screen during a workout' }} />
        </div>
      </div>
    </section>

    <section class="section pilot" id="pilot" aria-labelledby="pilot-title">
      <div class="wrap pilot__in">
        <div>
          <p class="hero__for">The free pilot</p>
          <h2 id="pilot-title">Free for the first {SITE.pilot.gyms} gyms in {SITE.pilot.city}, for {SITE.pilot.days} days</h2>
          <div class="pilot__cols">
            <div>
              <h3>You get</h3>
              <ul class="list">
                <li>The owner console, front-desk console and trainer console.</li>
                <li>We come to your gym and load your register or Excel in one visit.</li>
                <li>A QR poster for the desk and a member-app poster for the floor.</li>
                <li>WhatsApp support, seven days a week.</li>
                <li>Your member list stays yours, pilot or not.</li>
              </ul>
            </div>
            <div>
              <h3>We ask</h3>
              <ul class="list">
                <li>Thirty minutes with you each week.</li>
                <li>Honest feedback from you, your trainer and the desk.</li>
                <li>Permission to say you were a pilot gym, once you are happy.</li>
              </ul>
            </div>
          </div>
          <div class="hero__cta">
            <a href={wa(pilotMsg)} target="_blank" rel="noopener" class="btn btn--primary">Chat on WhatsApp</a>
            <a href={`${base}#download`} class="btn btn--ghost">Leave your number</a>
          </div>
          <p class="hero__note">What you need: a laptop or phone with internet. Face check-in hardware is optional and comes later. Dues reminders and UPI run in demo mode during the pilot.</p>
        </div>
      </div>
    </section>

    <section class="section faq" aria-labelledby="faq-title">
      <div class="wrap faq__in">
        <h2 id="faq-title">Questions gym owners ask</h2>
        <div>
          {faq.map((q, i) => (<details open={i === 0}><summary><h3>{q.q}</h3><span class="plus" aria-hidden="true" /></summary><p>{q.a}</p></details>))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .own {
    font-size: 17px;
  }
  .own h2 {
    font-size: clamp(28px, 3vw, 40px);
  }
  .hero {
    padding: 128px 0 24px;
  }
  .hero__in,
  .two,
  .faq__in {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
  }
  .faq__in {
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    align-items: start;
  }
  .hero__for {
    display: inline-block;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(139, 92, 246, 0.16);
    color: var(--violet-2);
    font-size: 13px;
    font-weight: 700;
  }
  .hero h1 {
    margin-top: 16px;
    font-size: clamp(32px, 3.6vw, 50px);
    max-width: 18ch;
  }
  .hero__fix {
    margin-top: 14px;
    font-size: clamp(21px, 1.9vw, 28px);
    font-weight: 800;
    font-variation-settings: 'wdth' 118;
    letter-spacing: -0.02em;
    color: var(--violet-2);
  }
  .hero__lead,
  .lead {
    margin-top: 18px;
    max-width: 52ch;
    font-size: 17.5px;
    line-height: 1.6;
    color: var(--steel);
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .hero__note {
    margin-top: 16px;
    max-width: 52ch;
    font-size: 14px;
    line-height: 1.5;
    color: var(--dim);
  }
  .hero__art {
    position: relative;
  }
  .hero__art::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 55%;
    width: 110%;
    aspect-ratio: 1;
    translate: -50% -50%;
    background: radial-gradient(closest-side, rgba(139, 92, 246, 0.3), transparent 70%);
    pointer-events: none;
  }
  .hero__art--phone {
    display: flex;
    justify-content: center;
  }
  .hero__art--phone :global(.phone) {
    width: min(280px, 70%);
  }

  .grid4 {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }
  .grid4 li,
  .shots li {
    padding: 22px 24px;
    border-radius: 16px;
    background: linear-gradient(180deg, #1f2129, #171920);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.07),
      0 0 0 1px var(--line);
  }
  .grid4 h3 {
    font-size: 19px;
    font-variation-settings: 'wdth' 108;
  }
  .grid4 p,
  .shots p {
    margin-top: 8px;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--steel);
  }

  .vs {
    width: 100%;
    margin-top: 28px;
    border-collapse: collapse;
    font-size: 16px;
  }
  .vs th,
  .vs td {
    padding: 14px 16px;
    text-align: left;
    border-top: 1px solid var(--line);
    vertical-align: top;
  }
  .vs thead th {
    border-top: 0;
    font-size: 13px;
    font-weight: 700;
    color: var(--dim);
  }
  .vs tbody th {
    font-weight: 700;
    color: var(--chalk);
    width: 24%;
  }
  .vs td:nth-child(2) {
    color: var(--steel);
  }
  .vs td:nth-child(3) {
    color: var(--chalk);
    font-weight: 600;
  }

  .shots {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }
  .shots li {
    padding: 16px;
  }
  .shots p {
    margin-top: 12px;
    padding: 0 6px;
  }

  .list {
    margin: 16px 0 0;
    padding-left: 20px;
    line-height: 1.6;
    color: var(--steel);
  }
  .list li + li {
    margin-top: 8px;
  }
  .list strong {
    color: var(--chalk);
  }

  .pilot {
    background: linear-gradient(180deg, rgba(139, 92, 246, 0.1), transparent);
  }
  .pilot__cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
    margin-top: 24px;
  }
  .pilot h3 {
    font-size: 18px;
  }

  details {
    border-top: 1px solid var(--line);
  }
  details:last-child {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 0;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary h3 {
    font-size: 18px;
    font-variation-settings: 'wdth' 105;
  }
  .plus {
    position: relative;
    flex: 0 0 auto;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--line-2);
  }
  .plus::before,
  .plus::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 11px;
    height: 2px;
    background: var(--chalk);
    translate: -50% -50%;
  }
  .plus::after {
    transform: rotate(90deg);
  }
  details[open] .plus::after {
    transform: none;
  }
  details p {
    padding: 0 44px 20px 0;
    font-size: 16px;
    line-height: 1.65;
    color: var(--steel);
  }

  @media (max-width: 960px) {
    .hero {
      padding-top: 108px;
    }
    .hero__in,
    .two,
    .faq__in,
    .pilot__cols {
      grid-template-columns: 1fr;
    }
    .grid4,
    .shots {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    .grid4,
    .shots {
      grid-template-columns: 1fr;
    }
    .vs {
      font-size: 14px;
    }
    .vs th,
    .vs td {
      padding: 10px 8px;
    }
  }
</style>
