---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { FEATURES } from '../features';
const base = import.meta.env.BASE_URL;
---

<Layout title="Page not found · SpotAI" description="That page is not here. Jump to a SpotAI feature, the gym owner pilot, or pricing.">
  <Nav />
  <main id="main" class="nf">
    <div class="wrap">
      <h1 class="wide">That page is not here.</h1>
      <p class="lead">Try one of these.</p>
      <ul class="links" role="list">
        <li><a href={base}>Home</a></li>
        <li><a href={`${base}for-gym-owners/`}>For gym owners</a></li>
        <li><a href={`${base}pricing/`}>Pricing</a></li>
        {FEATURES.map((f) => (<li><a href={`${base}features/${f.slug}/`}>{f.nav}</a></li>))}
      </ul>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .nf {
    min-height: 70vh;
    padding: 160px 0 80px;
  }
  .nf h1 {
    font-size: clamp(34px, 4vw, 56px);
  }
  .nf .lead {
    margin-top: 14px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }
  .links a {
    display: inline-block;
    padding: 10px 16px;
    border-radius: 10px;
    box-shadow: inset 0 0 0 1px var(--line-2);
    text-decoration: none;
    font-weight: 600;
    color: var(--chalk);
  }
</style>
