---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { featuresFor } from '../i18n/features';
import { strings } from '../i18n/strings';
// English only; the language switcher sends other languages to their home page.
const t = strings('en').notFound;
---

<Layout noindex title={t.title} description={t.description}>
  <Nav langs={['en']} fallback="/" />
  <main id="main" class="nf">
    <div class="wrap">
      <h1 class="wide">{t.h1}</h1>
      <p class="lead">{t.lead}</p>
      <ul class="links" role="list">
        <li><a href="/">{t.home}</a></li>
        <li><a href="/for-gym-owners/">{t.forOwners}</a></li>
        <li><a href="/pricing/">{t.pricing}</a></li>
        {featuresFor('en').map((f) => (<li><a href={`/features/${f.slug}/`}>{f.nav}</a></li>))}
      </ul>
    </div>
  </main>
  <Footer langs={['en']} fallback="/" />
</Layout>

<style>
  .nf {
    min-height: 70vh;
    padding: 160px 0 80px;
  }
  .nf h1 {
    font-size: clamp(34px, 4vw, 56px);
  }
  .nf .lead {
    margin-top: 14px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }
  .links a {
    display: inline-block;
    padding: 10px 16px;
    border-radius: 10px;
    box-shadow: inset 0 0 0 1px var(--line-2);
    text-decoration: none;
    font-weight: 600;
    color: var(--chalk);
  }
</style>
