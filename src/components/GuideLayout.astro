---
// A guide page: the answer first, then the detail, a few questions, and a way into the app.
import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import { SITE } from '../site';
import { strings } from '../i18n/strings';
import { lang as langInfo, langOf, localize, type LangCode } from '../i18n/config';
interface Props {
  slug: string;
  title: string;
  description: string;
  h1: string;
  answer: string;
  updated: string;
  faq: { q: string; a: string }[];
  cta: { label: string; href: string; text: string };
  /** First publication date (YYYY-MM-DD) when it differs from `updated`. */
  published?: string;
  /** Cover image path under the site root, e.g. og/guides/<slug>.png (1200x630). */
  cover?: string;
  /** Languages this guide exists in (Markdown guides); every language when omitted. */
  langs?: LangCode[];
}
const { slug, title, description, h1, answer, updated, faq, cta, published, cover, langs } = Astro.props;
const code = langOf(Astro.url.pathname);
const L = langInfo(code);
const t = strings(code).guide;
const guides = localize('/guides/', code);
const url = new URL(`${guides}${slug}/`, SITE.url).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': `${url}#article`,
      headline: h1,
      description,
      url,
      dateModified: updated,
      datePublished: published ?? updated,
      ...(cover ? { image: `${SITE.url}${cover}` } : {}),
      inLanguage: L.tag,
      author: { '@type': 'Person', name: SITE.author.name, url: SITE.author.url },
      publisher: { '@id': `${SITE.url}#org` },
      isPartOf: { '@id': `${SITE.url}#website` },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'SpotAI', item: new URL(localize('/', code), SITE.url).href },
        { '@type': 'ListItem', position: 2, name: t.crumb, item: new URL(guides, SITE.url).href },
        { '@type': 'ListItem', position: 3, name: h1, item: url },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
  ],
};
---

<Layout title={title} description={description} jsonLd={jsonLd} image={cover ? `${SITE.url}${cover}` : undefined} imageAlt={cover ? h1 : undefined} langs={langs}>
  <Nav langs={langs} />
  <main id="main" class="guide">
    <article class="wrap guide__in">
      <nav class="crumbs" aria-label={strings(code).common.breadcrumb}>
        <a href={localize('/', code)}>SpotAI</a><span aria-hidden="true">/</span><a href={guides}>{t.crumb}</a>
      </nav>
      <h1 class="wide">{h1}</h1>
      <p class="guide__answer">{answer}</p>
      <p class="guide__meta">{t.updated} <time datetime={updated}>{new Date(updated).toLocaleDateString(L.tag, { day: 'numeric', month: 'long', year: 'numeric', numberingSystem: 'latn' })}</time> · {SITE.author.name}</p>
      <div class="guide__body">
        <slot />
      </div>
      <section class="guide__faq" aria-labelledby="gfaq">
        <h2 id="gfaq">{t.questions}</h2>
        {
          faq.map((f, i) => (
            <details open={i === 0}>
              <summary>
                <h3>{f.q}</h3>
              </summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </section>
      <aside class="guide__cta">
        <p>{cta.text}</p>
        <a href={cta.href} class="btn btn--primary">{cta.label}</a>
      </aside>
    </article>
  </main>
  <Footer langs={langs} />
</Layout>

<style>
  .guide {
    padding: 128px 0 80px;
    font-size: 17px;
  }
  .guide__in {
    max-width: 780px;
  }
  .crumbs {
    display: flex;
    gap: 10px;
    font-size: 13.5px;
    color: var(--dim);
  }
  .crumbs a {
    color: var(--steel);
    text-decoration: none;
  }
  h1 {
    margin-top: 18px;
    font-size: clamp(32px, 4vw, 50px);
  }
  .guide__answer {
    margin-top: 18px;
    padding: 18px 20px;
    border-radius: 14px;
    background: rgba(139, 92, 246, 0.12);
    box-shadow: inset 0 0 0 1px rgba(196, 181, 253, 0.3);
    font-size: 18px;
    line-height: 1.6;
  }
  .guide__meta {
    margin-top: 12px;
    font-size: 13px;
    color: var(--dim);
  }
  .guide__body {
    margin-top: 32px;
    line-height: 1.7;
    color: var(--steel);
  }
  .guide__body :global(h2) {
    margin: 40px 0 12px;
    font-size: clamp(24px, 2.6vw, 32px);
    color: var(--chalk);
  }
  .guide__body :global(h3) {
    margin: 24px 0 8px;
    font-size: 19px;
    color: var(--chalk);
  }
  .guide__body :global(p),
  .guide__body :global(ul),
  .guide__body :global(ol) {
    margin: 12px 0 0;
  }
  .guide__body :global(li + li) {
    margin-top: 6px;
  }
  .guide__body :global(strong) {
    color: var(--chalk);
  }
  .guide__body :global(a) {
    color: var(--violet-2);
  }
  .guide__body :global(table) {
    width: 100%;
    margin-top: 14px;
    border-collapse: collapse;
    font-size: 15px;
  }
  .guide__body :global(th),
  .guide__body :global(td) {
    padding: 10px 12px;
    border-top: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }
  .guide__body :global(thead th) {
    border-top: 0;
    font-size: 13px;
    color: var(--dim);
  }
  .guide__body :global(td:not(:first-child)),
  .guide__body :global(th:not(:first-child)) {
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .guide__body :global(td:first-child) {
    color: var(--chalk);
  }
  .guide__body :global(.table-wrap) {
    overflow-x: auto;
  }
  .guide__body :global(.msg) {
    margin-top: 12px;
    padding: 14px 16px;
    border-radius: 12px;
    background: var(--iron);
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--chalk);
    white-space: pre-wrap;
    font-size: 15.5px;
    line-height: 1.6;
  }
  .guide__body :global(.note) {
    font-size: 14px;
    color: var(--dim);
  }
  .guide__faq {
    margin-top: 48px;
  }
  .guide__faq h2 {
    font-size: clamp(24px, 2.6vw, 32px);
  }
  details {
    border-top: 1px solid var(--line);
  }
  details:last-child {
    border-bottom: 1px solid var(--line);
  }
  summary {
    padding: 16px 0;
    cursor: pointer;
  }
  summary h3 {
    display: inline;
    font-size: 17px;
  }
  details p {
    padding: 0 0 18px;
    color: var(--steel);
    line-height: 1.65;
  }
  .guide__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 40px;
    padding: 22px 24px;
    border-radius: 16px;
    background: rgba(139, 92, 246, 0.14);
    box-shadow: inset 0 0 0 1px rgba(196, 181, 253, 0.3);
  }
  .guide__cta p {
    max-width: 46ch;
    font-weight: 700;
    color: var(--chalk);
  }
  @media (max-width: 760px) {
    .guide {
      padding-top: 104px;
    }
  }
</style>
