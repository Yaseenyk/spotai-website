---
import { SITE } from '../site';
import { strings } from '../i18n/strings';
import { langOf, localize } from '../i18n/config';
const code = langOf(Astro.url.pathname);
const T = strings(code);
const t = T.download;
const base = import.meta.env.BASE_URL;
const ownersUrl = new URL(localize('/for-gym-owners/', code), SITE.url).href;
---

<section class="section download" id="download" aria-labelledby="download-title">
  <div class="wrap download__in">
    <div class="download__copy">
      <h2 id="download-title">{t.title}</h2>
      <p class="lead">{t.lead}</p>
      <div class="demo">
        <div class="demo__head">
          <div>
            <h3>{t.demo.title}</h3>
            <p>{t.demo.body}</p>
          </div>
          <div class="demo__btns">
            <a href={`/${SITE.demo.apk}`} download class="btn btn--primary">{t.demo.android}</a>
            <a href={`/${SITE.demo.web}`} class="btn btn--ghost">{t.demo.iphone}</a>
          </div>
        </div>
        <ol class="demo__steps">
          {t.demo.steps.map((s) => <li set:html={s} />)}
        </ol>
        <p class="demo__meta" set:html={t.demo.meta} />
        <div class="demo__ios">
          <strong>{t.demo.iosTitle}</strong>
          <ol>
            {t.demo.ios.map((s) => <li set:html={s} />)}
          </ol>
          <a href={localize('/install-iphone/', code)} class="demo__guide">{t.demo.iosGuide} →</a>
        </div>
      </div>
      <div class="paths">
        <a class="path path--owner" href={`https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(T.common.waOwnerPilot)}`} target="_blank" rel="noopener">
          <strong>{t.owner.title}</strong>
          <span>{t.owner.body}</span>
          <em>{t.owner.cta}</em>
        </a>
        <a class="path" href={`https://wa.me/?text=${encodeURIComponent(T.common.waAskOwner(ownersUrl))}`} target="_blank" rel="noopener">
          <strong>{t.member.title}</strong>
          <span>{t.member.body}</span>
          <em>{t.member.cta}</em>
        </a>
      </div>
      <form
        id="waitlist"
        class="waitlist"
        action={`mailto:${SITE.email}`}
        method="post"
        enctype="text/plain"
        aria-label={t.form.label}
        data-service={SITE.emailjs.service}
        data-template={SITE.emailjs.template}
        data-key={SITE.emailjs.publicKey}
        data-to={SITE.email}
        data-sending={t.form.sending}
        data-sent={t.form.sent}
        data-error={t.form.error}
      >
        <input type="hidden" name="subject" value={t.form.subject} />
        <!-- Left empty by people; bots that fill every field are dropped quietly. -->
        <input class="waitlist__trap" name="company" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="waitlist__row">
          <label>
            <span>{t.form.name}</span>
            <input name="name" type="text" required autocomplete="name" />
          </label>
          <label>
            <span>{t.form.whatsapp}</span>
            <input name="whatsapp" type="tel" required inputmode="tel" autocomplete="tel" placeholder="98xxxxxxxx" />
          </label>
        </div>
        <div class="waitlist__row">
          <label>
            <span>{t.form.who}</span>
            <select name="who">
              <option value="member">{t.form.whoOptions.member}</option>
              <option value="owner">{t.form.whoOptions.owner}</option>
              <option value="trainer">{t.form.whoOptions.trainer}</option>
            </select>
          </label>
          <label>
            <span>{t.form.gym}</span>
            <input name="gym" type="text" required placeholder={t.form.gymPlaceholder} />
          </label>
        </div>
        <button type="submit" class="btn btn--primary">{t.form.submit}</button>
        <p class="waitlist__status" role="status" aria-live="polite"></p>
        <p class="waitlist__note">
          {t.form.noteForm} {t.form.orWrite}
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
        </p>
      </form>
    </div>
    <div class="download__art">
      <div class="phone">
        <img
          src={`${base}shots/m-dark-welcome.webp`}
          width="640"
          height="1385"
          alt={t.welcomeAlt}
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="phone phone--second">
        <img
          src={`${base}shots/m-light-home.webp`}
          width="640"
          height="1385"
          alt={t.homeAlt}
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>

<script>
  // Sends the waitlist form through EmailJS's REST API, so a lead reaches the inbox without a mail app.
  const form = document.querySelector<HTMLFormElement>('#waitlist');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const d = form.dataset;
    const status = form.querySelector<HTMLElement>('.waitlist__status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const f = new FormData(form);
    const get = (k: string) => String(f.get(k) ?? '').trim();
    if (get('company')) {
      status.textContent = d.sent!;
      return;
    }
    button.disabled = true;
    status.dataset.state = 'sending';
    status.textContent = d.sending!;
    const message = [
      `*** ${get('subject')} ***`,
      `Who: ${get('who')}`,
      `WhatsApp: ${get('whatsapp')}`,
      `Gym: ${get('gym')}`,
      `Page: ${location.pathname} (${document.documentElement.lang})`,
    ].join('\n');
    try {
      const res = await fetch('https://api.emailjs.com/api/v1.0/email/send', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          service_id: d.service,
          template_id: d.template,
          user_id: d.key,
          template_params: {
            name: get('name'),
            from_name: get('name'),
            to_name: 'Yaseen',
            email: d.to,
            to_email: d.to,
            message,
          },
        }),
      });
      if (!res.ok) throw new Error(`${res.status} ${await res.text()}`);
      status.dataset.state = 'sent';
      (window as unknown as { gaEvent?: (n: string, p?: object) => void }).gaEvent?.('generate_lead', { form_name: 'spotai-waitlist' });
      status.textContent = d.sent!;
      form.reset();
    } catch (err) {
      console.error('Waitlist send failed:', err);
      status.dataset.state = 'error';
      status.textContent = d.error!;
    } finally {
      button.disabled = false;
    }
  });
</script>

<style>
  .download {
    overflow: hidden;
  }
  .download__in {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
  }
  .download__copy h2 {
    font-size: clamp(32px, 3.6vw, 50px);
  }
  .download__copy .lead {
    margin-top: 16px;
  }
  .demo {
    margin-top: 28px;
    padding: 22px 24px;
    border-radius: 18px;
    background: rgba(139, 92, 246, 0.12);
    box-shadow: inset 0 0 0 1px rgba(196, 181, 253, 0.35);
  }
  .demo__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .demo h3 {
    font-size: 22px;
  }
  .demo__head p {
    margin-top: 4px;
    color: var(--steel);
    font-size: 15px;
  }
  .demo__steps {
    margin: 16px 0 0;
    padding-left: 20px;
    color: var(--steel);
    font-size: 15px;
    line-height: 1.6;
  }
  .demo__steps li + li {
    margin-top: 6px;
  }
  .demo code {
    padding: 1px 6px;
    border-radius: 6px;
    background: rgba(236, 233, 225, 0.08);
    color: var(--chalk);
    font-size: 13.5px;
  }
  .demo__meta {
    margin-top: 12px;
    font-size: 13px;
    color: var(--dim);
  }
  .demo__btns {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .demo__ios {
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    font-size: 14.5px;
    color: var(--steel);
  }
  .demo__ios strong:first-child {
    color: var(--chalk);
  }
  .demo__ios ol {
    margin: 8px 0 0;
    padding-left: 20px;
    line-height: 1.6;
  }
  .demo__ios a {
    color: var(--violet-2);
  }
  .waitlist__trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .waitlist__status:empty {
    display: none;
  }
  .waitlist__status {
    margin-top: 12px;
    font-weight: 600;
  }
  .waitlist__status[data-state='sent'] {
    color: var(--go);
  }
  .waitlist__status[data-state='error'] {
    color: var(--warn);
  }
  .demo__guide {
    display: inline-block;
    margin-top: 10px;
    font-weight: 700;
  }
  .paths {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 28px;
  }
  .path {
    display: grid;
    gap: 6px;
    padding: 18px 20px;
    border-radius: 16px;
    background: linear-gradient(180deg, #1f2129, #171920);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.07),
      0 0 0 1px var(--line);
    text-decoration: none;
    transition: box-shadow 0.25s ease;
  }
  .path:hover {
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.07),
      0 0 0 1px rgba(196, 181, 253, 0.6);
  }
  .path--owner {
    background: rgba(139, 92, 246, 0.16);
    box-shadow: inset 0 0 0 1px rgba(196, 181, 253, 0.35);
  }
  .path strong {
    font-size: 18px;
    font-weight: 800;
    font-variation-settings: 'wdth' 110;
    letter-spacing: -0.01em;
  }
  .path span {
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--steel);
  }
  .path em {
    margin-top: 4px;
    font-style: normal;
    font-size: 14px;
    font-weight: 700;
    color: #4ade80;
  }
  .waitlist {
    display: grid;
    gap: 12px;
    margin-top: 28px;
  }
  .waitlist__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .waitlist label {
    display: grid;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    color: var(--steel);
  }
  .waitlist .btn {
    justify-self: start;
  }
  .waitlist input,
  .waitlist select {
    min-height: 54px;
    padding: 0 16px;
    border: 0;
    border-radius: 10px;
    background: var(--iron);
    box-shadow: inset 0 0 0 1px var(--line-2);
    color: var(--chalk);
    font: inherit;
    font-size: 15.5px;
  }
  .waitlist input::placeholder {
    color: var(--dim);
  }
  .waitlist__note {
    font-size: 13.5px;
    color: var(--dim);
  }
  .waitlist__note a {
    color: var(--steel);
  }

  .download__art {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    min-height: 520px;
  }
  .download__art::before {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 120%;
    height: 70%;
    translate: -50% 0;
    background: radial-gradient(50% 60% at 50% 100%, rgba(139, 92, 246, 0.38), transparent 70%);
    pointer-events: none;
  }
  .download__art .phone {
    position: relative;
    width: 250px;
    flex: 0 0 auto;
    rotate: -5deg;
    translate: 24px 0;
    z-index: 2;
  }
  .download__art .phone--second {
    width: 210px;
    rotate: 6deg;
    translate: -24px 30px;
    z-index: 1;
    opacity: 0.95;
  }

  @media (max-width: 960px) {
    .download__in {
      grid-template-columns: 1fr;
    }
    .download__art {
      min-height: 0;
      margin-top: 16px;
    }
    .download__art .phone {
      width: 200px;
    }
    .download__art .phone--second {
      width: 170px;
    }
  }
  @media (max-width: 600px) {
    .waitlist__row,
    .paths {
      grid-template-columns: 1fr;
    }
  }
</style>
