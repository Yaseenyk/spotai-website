---
import { SITE } from '../site';
const base = import.meta.env.BASE_URL;
---

<section class="section download" id="download" aria-labelledby="download-title">
  <div class="wrap download__in">
    <div class="download__copy">
      <h2 id="download-title">Get SpotAI at your gym</h2>
      <p class="lead">
        Try the Android demo today. Gym owners in {SITE.pilot.city} get a free pilot. Tell us who you are and we reply
        on WhatsApp.
      </p>

      <div class="demo">
        <div class="demo__head">
          <div>
            <h3>Try the demo now</h3>
            <p>The full member app, running offline on your phone. Nothing you log leaves the phone.</p>
          </div>
          <div class="demo__btns">
            <a href={`/${SITE.demo.apk}`} download class="btn btn--primary">Download for Android</a>
            <a href={`/${SITE.demo.web}`} class="btn btn--ghost">Open on iPhone</a>
          </div>
        </div>
        <ol class="demo__steps">
          <li>Open the downloaded <code>spotai-demo.apk</code>. If Android asks, allow installs from your browser.</li>
          <li>Tap <strong>I already have an account</strong> and sign in as <code>{SITE.demo.logins[0]}</code> or <code>{SITE.demo.logins[1]}</code>, password <code>{SITE.demo.password}</code>.</li>
          <li>Check in, pick a session, log sets. It keeps working across days, like the real thing.</li>
        </ol>
        <p class="demo__meta">Version {SITE.demo.version} · Android {SITE.demo.android} or newer · {SITE.demo.size} · signed by SpotAI</p>
        <div class="demo__ios">
          <strong>On iPhone</strong>
          <ol>
            <li>Open <a href={`/${SITE.demo.web}`}>spotai.streamerosai.com/{SITE.demo.web}</a> in <strong>Safari</strong>.</li>
            <li>Tap the <strong>Share</strong> button, then <strong>Add to Home Screen</strong>.</li>
            <li>Open SpotAI from your home screen. It runs full-screen and keeps your data on the phone. Same sign-in as above.</li>
          </ol>
        </div>
      </div>

      <div class="paths">
        <a class="path path--owner" href={`https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(`Hi SpotAI, I run a gym in ${SITE.pilot.city} and want the free pilot.`)}`} target="_blank" rel="noopener">
          <strong>I own a gym</strong>
          <span>Free {SITE.pilot.days}-day pilot for the first {SITE.pilot.gyms} {SITE.pilot.city} gyms. We load your register for you.</span>
          <em>Chat on WhatsApp</em>
        </a>
        <a class="path" href={`https://wa.me/?text=${encodeURIComponent('Bhaiya, can we get SpotAI at our gym? Free pilot for Hyderabad gyms: https://spotai.streamerosai.com/for-gym-owners/')}`} target="_blank" rel="noopener">
          <strong>I train at a gym</strong>
          <span>Ask your gym owner to switch it on. One tap sends them the pilot link.</span>
          <em>Send to my gym owner</em>
        </a>
      </div>

      <form
        id="waitlist"
        class="waitlist"
        action={SITE.formEndpoint || `mailto:${SITE.email}`}
        method={SITE.formEndpoint ? 'post' : 'get'}
        aria-label="Join the waitlist"
      >
        <input type="hidden" name="subject" value="SpotAI waitlist" />
        <div class="waitlist__row">
          <label>
            <span>Your name</span>
            <input name="name" type="text" required autocomplete="name" />
          </label>
          <label>
            <span>WhatsApp number</span>
            <input name="whatsapp" type="tel" required inputmode="tel" autocomplete="tel" placeholder="98xxxxxxxx" />
          </label>
        </div>
        <div class="waitlist__row">
          <label>
            <span>I am a</span>
            <select name="who">
              <option value="member">Gym member</option>
              <option value="owner">Gym owner</option>
              <option value="trainer">Trainer</option>
            </select>
          </label>
          <label>
            <span>Gym name and area</span>
            <input name="gym" type="text" required placeholder="e.g. Iron Temple, Kukatpally" />
          </label>
        </div>
        <button type="submit" class="btn btn--primary">Join the waitlist</button>
        <p class="waitlist__note">
          {SITE.formEndpoint ? 'We reply on WhatsApp within a day.' : 'Opens your mail app with the details filled in.'} Or write to
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
        </p>
      </form>
    </div>

    <div class="download__art">
      <div class="phone">
        <img
          src={`${base}shots/m-dark-welcome.webp`}
          width="640"
          height="1385"
          alt="SpotAI welcome screen with a kettlebell, dumbbell and shaker, the line Train smarter get stronger, and Continue with email"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="phone phone--second">
        <img
          src={`${base}shots/m-light-home.webp`}
          width="640"
          height="1385"
          alt="SpotAI home screen in light mode: Ready to train, Check in button, day streak and visits this week"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .download {
    overflow: hidden;
  }
  .download__in {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
  }
  .download__copy h2 {
    font-size: clamp(32px, 3.6vw, 50px);
  }
  .download__copy .lead {
    margin-top: 16px;
  }
  .demo {
    margin-top: 28px;
    padding: 22px 24px;
    border-radius: 18px;
    background: rgba(139, 92, 246, 0.12);
    box-shadow: inset 0 0 0 1px rgba(196, 181, 253, 0.35);
  }
  .demo__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .demo h3 {
    font-size: 22px;
  }
  .demo__head p {
    margin-top: 4px;
    color: var(--steel);
    font-size: 15px;
  }
  .demo__steps {
    margin: 16px 0 0;
    padding-left: 20px;
    color: var(--steel);
    font-size: 15px;
    line-height: 1.6;
  }
  .demo__steps li + li {
    margin-top: 6px;
  }
  .demo code {
    padding: 1px 6px;
    border-radius: 6px;
    background: rgba(236, 233, 225, 0.08);
    color: var(--chalk);
    font-size: 13.5px;
  }
  .demo__meta {
    margin-top: 12px;
    font-size: 13px;
    color: var(--dim);
  }
  .demo__btns {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .demo__ios {
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    font-size: 14.5px;
    color: var(--steel);
  }
  .demo__ios strong:first-child {
    color: var(--chalk);
  }
  .demo__ios ol {
    margin: 8px 0 0;
    padding-left: 20px;
    line-height: 1.6;
  }
  .demo__ios a {
    color: var(--violet-2);
  }
  .paths {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 28px;
  }
  .path {
    display: grid;
    gap: 6px;
    padding: 18px 20px;
    border-radius: 16px;
    background: linear-gradient(180deg, #1f2129, #171920);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.07),
      0 0 0 1px var(--line);
    text-decoration: none;
    transition: box-shadow 0.25s ease;
  }
  .path:hover {
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.07),
      0 0 0 1px rgba(196, 181, 253, 0.6);
  }
  .path--owner {
    background: rgba(139, 92, 246, 0.16);
    box-shadow: inset 0 0 0 1px rgba(196, 181, 253, 0.35);
  }
  .path strong {
    font-size: 18px;
    font-weight: 800;
    font-variation-settings: 'wdth' 110;
    letter-spacing: -0.01em;
  }
  .path span {
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--steel);
  }
  .path em {
    margin-top: 4px;
    font-style: normal;
    font-size: 14px;
    font-weight: 700;
    color: #4ade80;
  }
  .waitlist {
    display: grid;
    gap: 12px;
    margin-top: 28px;
  }
  .waitlist__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .waitlist label {
    display: grid;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    color: var(--steel);
  }
  .waitlist .btn {
    justify-self: start;
  }
  .waitlist input,
  .waitlist select {
    min-height: 54px;
    padding: 0 16px;
    border: 0;
    border-radius: 10px;
    background: var(--iron);
    box-shadow: inset 0 0 0 1px var(--line-2);
    color: var(--chalk);
    font: inherit;
    font-size: 15.5px;
  }
  .waitlist input::placeholder {
    color: var(--dim);
  }
  .waitlist__note {
    font-size: 13.5px;
    color: var(--dim);
  }
  .waitlist__note a {
    color: var(--steel);
  }

  .download__art {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    min-height: 520px;
  }
  .download__art::before {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 120%;
    height: 70%;
    translate: -50% 0;
    background: radial-gradient(50% 60% at 50% 100%, rgba(139, 92, 246, 0.38), transparent 70%);
    pointer-events: none;
  }
  .download__art .phone {
    position: relative;
    width: 250px;
    flex: 0 0 auto;
    rotate: -5deg;
    translate: 24px 0;
    z-index: 2;
  }
  .download__art .phone--second {
    width: 210px;
    rotate: 6deg;
    translate: -24px 30px;
    z-index: 1;
    opacity: 0.95;
  }

  @media (max-width: 960px) {
    .download__in {
      grid-template-columns: 1fr;
    }
    .download__art {
      min-height: 0;
      margin-top: 16px;
    }
    .download__art .phone {
      width: 200px;
    }
    .download__art .phone--second {
      width: 170px;
    }
  }
  @media (max-width: 600px) {
    .waitlist__row,
    .demo {
    margin-top: 28px;
    padding: 22px 24px;
    border-radius: 18px;
    background: rgba(139, 92, 246, 0.12);
    box-shadow: inset 0 0 0 1px rgba(196, 181, 253, 0.35);
  }
  .demo__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .demo h3 {
    font-size: 22px;
  }
  .demo__head p {
    margin-top: 4px;
    color: var(--steel);
    font-size: 15px;
  }
  .demo__steps {
    margin: 16px 0 0;
    padding-left: 20px;
    color: var(--steel);
    font-size: 15px;
    line-height: 1.6;
  }
  .demo__steps li + li {
    margin-top: 6px;
  }
  .demo code {
    padding: 1px 6px;
    border-radius: 6px;
    background: rgba(236, 233, 225, 0.08);
    color: var(--chalk);
    font-size: 13.5px;
  }
  .demo__meta {
    margin-top: 12px;
    font-size: 13px;
    color: var(--dim);
  }
  .demo__btns {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .demo__ios {
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    font-size: 14.5px;
    color: var(--steel);
  }
  .demo__ios strong:first-child {
    color: var(--chalk);
  }
  .demo__ios ol {
    margin: 8px 0 0;
    padding-left: 20px;
    line-height: 1.6;
  }
  .demo__ios a {
    color: var(--violet-2);
  }
  .paths {
      grid-template-columns: 1fr;
    }
  }
</style>
