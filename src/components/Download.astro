---
import { SITE } from '../site';
const base = import.meta.env.BASE_URL;
---

<section class="section download" id="download" aria-labelledby="download-title">
  <div class="wrap download__in">
    <div class="download__copy">
      <h2 id="download-title">Get SpotAI at your gym</h2>
      <p class="lead">
        In private demo with partner gyms today. Join the waitlist and you get the Play Store and App Store links on
        launch day. Gym owners: tell us about your gym and we set up a pilot.
      </p>

      <div class="stores" aria-label="App stores">
        <a class="store" href="#waitlist" aria-label="Google Play, coming soon">
          <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
            <path fill="#34a853" d="M3.6 2.4 13 12l-9.4 9.6c-.4-.3-.6-.8-.6-1.4V3.8c0-.6.2-1.1.6-1.4z" />
            <path fill="#fbbc04" d="M16.6 15.6 13 12l3.6-3.6 4.2 2.4c1.1.6 1.1 1.8 0 2.4z" />
            <path fill="#4285f4" d="M3.6 2.4c.4-.3 1-.4 1.6 0l11.4 6-3.6 3.6z" />
            <path fill="#ea4335" d="M13 12l3.6 3.6-11.4 6c-.6.4-1.2.3-1.6 0z" />
          </svg>
          <span><small>Coming soon on</small>Google Play</span>
        </a>
        <a class="store" href="#waitlist" aria-label="App Store, coming soon">
          <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true">
            <path
              d="M16.4 12.6c0-2.6 2.1-3.8 2.2-3.9-1.2-1.8-3.1-2-3.8-2-1.6-.2-3.1.9-3.9.9-.8 0-2-.9-3.4-.9-1.7 0-3.3 1-4.2 2.6-1.8 3.1-.5 7.7 1.3 10.2.8 1.2 1.8 2.6 3.1 2.5 1.2 0 1.7-.8 3.2-.8s1.9.8 3.2.8c1.3 0 2.2-1.2 3-2.5 1-1.4 1.3-2.7 1.4-2.8-.1 0-2.6-1-2.6-4.1zM13.9 4.9c.7-.8 1.1-1.9 1-3-1 0-2.1.6-2.8 1.4-.6.7-1.2 1.8-1 2.9 1 .1 2.1-.5 2.8-1.3z"
            />
          </svg>
          <span><small>Coming soon on the</small>App Store</span>
        </a>
      </div>

      <form id="waitlist" class="waitlist" action={`mailto:${SITE.email}`} method="get" aria-label="Join the waitlist">
        <input type="hidden" name="subject" value="SpotAI waitlist" />
        <label class="sr-only" for="wl-email">Your email</label>
        <input id="wl-email" name="body" type="email" required placeholder="you@example.com" autocomplete="email" />
        <label class="sr-only" for="wl-who">I am a</label>
        <select id="wl-who" name="who" aria-label="I am a">
          <option value="member">Gym member</option>
          <option value="owner">Gym owner</option>
          <option value="trainer">Trainer</option>
        </select>
        <button type="submit" class="btn btn--primary">Join the waitlist</button>
        <p class="waitlist__note">
          Opens your mail app with the details filled in. Or write to
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
        </p>
      </form>
    </div>

    <div class="download__art">
      <div class="phone">
        <img
          src={`${base}shots/m-dark-welcome.webp`}
          width="640"
          height="1385"
          alt="SpotAI welcome screen with a kettlebell, dumbbell and shaker, the line Train smarter get stronger, and Continue with email"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="phone phone--second">
        <img
          src={`${base}shots/m-light-home.webp`}
          width="640"
          height="1385"
          alt="SpotAI home screen in light mode: Ready to train, Check in button, day streak and visits this week"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .download {
    overflow: hidden;
  }
  .download__in {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
  }
  .download__copy h2 {
    font-size: clamp(32px, 3.6vw, 50px);
  }
  .download__copy .lead {
    margin-top: 16px;
  }
  .stores {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .store {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 56px;
    padding: 0 18px 0 14px;
    border-radius: 12px;
    background: #0b0c0f;
    box-shadow: inset 0 0 0 1px var(--line-2);
    color: var(--chalk);
    text-decoration: none;
    transition: box-shadow 0.25s ease;
  }
  .store:hover {
    box-shadow: inset 0 0 0 1.5px var(--chalk);
  }
  .store span {
    display: grid;
    font-size: 17px;
    font-weight: 700;
    line-height: 1.1;
  }
  .store small {
    font-size: 11px;
    font-weight: 500;
    color: var(--steel);
  }
  .waitlist {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: 10px;
    margin-top: 28px;
  }
  .waitlist input,
  .waitlist select {
    min-height: 54px;
    padding: 0 16px;
    border: 0;
    border-radius: 10px;
    background: var(--iron);
    box-shadow: inset 0 0 0 1px var(--line-2);
    color: var(--chalk);
    font: inherit;
    font-size: 15.5px;
  }
  .waitlist input::placeholder {
    color: var(--dim);
  }
  .waitlist__note {
    grid-column: 1 / -1;
    font-size: 13.5px;
    color: var(--dim);
  }
  .waitlist__note a {
    color: var(--steel);
  }

  .download__art {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    min-height: 520px;
  }
  .download__art::before {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 120%;
    height: 70%;
    translate: -50% 0;
    background: radial-gradient(50% 60% at 50% 100%, rgba(139, 92, 246, 0.38), transparent 70%);
    pointer-events: none;
  }
  .download__art .phone {
    position: relative;
    width: 250px;
    flex: 0 0 auto;
    rotate: -5deg;
    translate: 24px 0;
    z-index: 2;
  }
  .download__art .phone--second {
    width: 210px;
    rotate: 6deg;
    translate: -24px 30px;
    z-index: 1;
    opacity: 0.95;
  }

  @media (max-width: 960px) {
    .download__in {
      grid-template-columns: 1fr;
    }
    .download__art {
      min-height: 0;
      margin-top: 16px;
    }
    .download__art .phone {
      width: 200px;
    }
    .download__art .phone--second {
      width: 170px;
    }
  }
  @media (max-width: 600px) {
    .waitlist {
      grid-template-columns: 1fr;
    }
    .store {
      flex: 1 1 100%;
    }
  }
</style>
