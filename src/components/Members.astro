---
const base = import.meta.env.BASE_URL;
const steps = [
  {
    problem: 'No idea what to train today',
    fix: 'Check in and the app picks today’s session from your last week: the muscle group that’s most rested, or cardio, cycling, mobility.',
    src: 'm-dark-picker.webp',
    pos: '50% 57%',
    alt: 'Session picker: What are you training today? Strength is suggested with the reason, then Cardio, Cycling and Mobility',
  },
  {
    problem: 'Same three exercises every time',
    fix: 'Tick the ones you want. Each exercise shows how many times you did it this week, so the gaps are obvious.',
    src: 'm-dark-exercises.webp',
    pos: '50% 43%',
    alt: 'Exercise checklist for Back and biceps with Lat pulldown, Dumbbell row, Biceps curl and Hammer curl, each showing how many times it was done this week',
  },
  {
    problem: 'Sets never get written down',
    fix: 'Reps and kilograms per set, a 30-second short if you forgot the move, or let the camera count the set for you.',
    src: 'm-dark-workout.webp',
    pos: '50% 19%',
    alt: 'Workout screen for Lat pulldown with a how-to, Watch short and Record set buttons and sets of reps and kilograms to log',
  },
];
---

<section class="section members" id="members" aria-labelledby="members-title">
  <div class="wrap">
    <div class="members__head">
      <h2 id="members-title">Walk in with no plan? Not anymore.</h2>
      <p class="lead">Check in and SpotAI gives you today’s workout, then logs every set.</p>
    </div>

    <ol class="steps" role="list">
      {
        steps.map((s, i) => (
          <li class="step">
            <div class="step__shot">
              <img
                src={`${base}shots/${s.src}`}
                width="640"
                height="1385"
                alt={s.alt}
                loading="lazy"
                decoding="async"
                style={`object-position: ${s.pos}`}
              />
            </div>
            <div class="step__text">
              <span class="step__n" aria-hidden="true">{i + 1}</span>
              <h3>{s.problem}</h3>
              <p>{s.fix}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .members__head {
    max-width: 640px;
    margin-bottom: clamp(32px, 5vw, 56px);
  }
  .members__head h2 {
    font-size: clamp(30px, 3.4vw, 46px);
  }
  .members__head .lead {
    margin-top: 14px;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .step {
    display: grid;
    grid-template-rows: auto 1fr;
    border-radius: 20px;
    background: linear-gradient(180deg, #1f2129, #171920);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.07),
      0 0 0 1px var(--line),
      0 30px 50px -30px rgba(0, 0, 0, 0.9);
    overflow: hidden;
  }
  .step__shot {
    position: relative;
    aspect-ratio: 4 / 3;
    background: #0b0c0f;
  }
  .step__shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .step__shot::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 40%;
    background: linear-gradient(180deg, transparent, rgba(23, 25, 32, 0.9));
  }
  .step__text {
    position: relative;
    padding: 18px 22px 24px;
  }
  .step__n {
    position: absolute;
    top: -16px;
    left: 22px;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--violet);
    color: #fff;
    font-size: 14px;
    font-weight: 800;
    box-shadow: 0 0 0 4px #171920;
  }
  .step h3 {
    margin-top: 10px;
    font-size: 21px;
    line-height: 1.15;
  }
  .step p {
    margin-top: 10px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--steel);
  }

  @media (max-width: 960px) {
    .steps {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .step {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      grid-template-rows: none;
    }
    .step__shot {
      aspect-ratio: auto;
      min-height: 100%;
    }
    .step__shot::after {
      inset: 0 0 0 auto;
      width: 40%;
      height: auto;
      background: linear-gradient(90deg, transparent, rgba(23, 25, 32, 0.9));
    }
    .step__n {
      position: static;
      box-shadow: none;
    }
    .step h3 {
      font-size: 19px;
    }
  }
  @media (max-width: 560px) {
    .step {
      grid-template-columns: 1fr;
    }
    .step__shot {
      aspect-ratio: 16 / 10;
      min-height: 0;
    }
    .step__shot::after {
      inset: auto 0 0;
      width: auto;
      height: 40%;
      background: linear-gradient(180deg, transparent, rgba(23, 25, 32, 0.9));
    }
  }
</style>
