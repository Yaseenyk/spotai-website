---
import { SITE } from '../site';
const exercises = [
  ['squat', 'Squat'],
  ['deadlift', 'Deadlift'],
  ['bench', 'Bench press'],
  ['curl', 'Biceps curl'],
  ['pulldown', 'Lat pulldown'],
  ['press', 'Overhead press'],
];
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="wrap hero__in">
    <div class="hero__copy">
      <h1 id="hero-title" class="hero__title wide">No spotter. No plan. Dues on WhatsApp.</h1>
      <p class="hero__sub">SpotAI fixes all three.</p>
      <p class="hero__lead">
        The AI gym app for Indian gyms: form check on your phone camera, today’s plan, your gym’s leaderboard, dues
        paid with UPI.
      </p>
      <div class="hero__cta">
        <a href={`/${SITE.demo.apk}`} download class="btn btn--primary">Download the Android demo</a>
        <a href="/for-gym-owners/" class="btn btn--ghost">Gym owner? Free pilot</a>
      </div>
      <p class="hero__note">Android {SITE.demo.android}+, {SITE.demo.size}, works offline. <a href="#download">Install steps and iPhone</a></p>
    </div>

    <div class="stage" data-stage>
      <div class="stage__light" aria-hidden="true"></div>

      <svg class="chalk chalk--rack" viewBox="0 0 60 600" aria-hidden="true">
        <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" data-chalk>
          <path d="M18 0 V600 M42 0 V600" />
          {[40, 100, 160, 220, 280, 340, 400, 460, 520].map((y) => <circle cx="30" cy={y} r="5" />)}
        </g>
      </svg>
      <svg class="chalk chalk--plate chalk--plate2" viewBox="0 0 320 320" aria-hidden="true" data-kit data-depth="0.35">
        <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" data-chalk>
          <circle cx="160" cy="160" r="150" />
          <circle cx="160" cy="160" r="112" />
          <circle cx="160" cy="160" r="30" />
        </g>
        <text x="160" y="76" text-anchor="middle" class="chalk__label">15</text>
      </svg>
      <svg class="chalk chalk--plate" viewBox="0 0 320 320" aria-hidden="true" data-kit data-depth="0.5">
        <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" data-chalk>
          <circle cx="160" cy="160" r="150" />
          <circle cx="160" cy="160" r="112" />
          <circle cx="160" cy="160" r="30" />
          <path d="M160 10 v24 M160 286 v24 M10 160 h24 M286 160 h24" />
        </g>
        <text x="160" y="76" text-anchor="middle" class="chalk__label">20</text>
      </svg>

      <div class="set" data-rep-box>
        <span class="set__name" data-set-name>Squat</span>
        <b class="set__count wide" data-rep>0</b>
        <span class="set__ticks" aria-hidden="true" data-ticks><i></i><i></i><i></i><i></i></span>
        <span class="set__label">reps this set</span>
      </div>
      <div class="cue" data-hflag>Knees out over your toes</div>

      <!-- The lifter. Side view; every joint is driven by the exercise reel in motion.ts. -->
      <svg class="figure" viewBox="0 0 520 560" aria-hidden="true" data-figure>
        <ellipse cx="270" cy="508" rx="130" ry="9" fill="currentColor" opacity="0.1" />
        <g data-gear="bench" opacity="0">
          <rect x="110" y="372" width="300" height="22" rx="6" fill="var(--iron-2)" stroke="var(--line-2)" />
          <rect x="150" y="394" width="14" height="106" fill="var(--iron-2)" />
          <rect x="356" y="394" width="14" height="106" fill="var(--iron-2)" />
        </g>
        <g data-gear="seat" opacity="0">
          <rect x="190" y="392" width="120" height="20" rx="6" fill="var(--iron-2)" stroke="var(--line-2)" />
          <rect x="242" y="412" width="16" height="88" fill="var(--iron-2)" />
          <rect x="292" y="356" width="80" height="16" rx="6" fill="var(--iron-2)" stroke="var(--line-2)" />
        </g>
        <line data-gear="cable" x1="300" y1="0" x2="300" y2="100" stroke="var(--steel)" stroke-width="3" opacity="0" />
        <circle data-prop="plate" cx="238" cy="156" r="46" fill="var(--rubber)" stroke="currentColor" stroke-width="7" />
        <g fill="var(--chalk-2)" stroke="var(--chalk-2)" stroke-linecap="round" opacity="0.5">
          <line data-f="uarmB" x1="237" y1="150" x2="267" y2="202" stroke-width="17" />
          <line data-f="farmB" x1="267" y1="202" x2="219" y2="150" stroke-width="14" />
          <circle data-f="handB" cx="219" cy="150" r="9" stroke="none" />
          <line data-f="thighB" x1="237" y1="300" x2="243" y2="400" stroke-width="21" />
          <line data-f="shinB" x1="243" y1="400" x2="237" y2="500" stroke-width="16" />
          <line data-f="footB" x1="237" y1="500" x2="267" y2="500" stroke-width="12" />
        </g>
        <g fill="currentColor" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
          <line data-f="thigh" x1="250" y1="300" x2="256" y2="400" stroke-width="23" />
          <line data-f="shin" x1="256" y1="400" x2="250" y2="500" stroke-width="17" />
          <line data-f="foot" x1="250" y1="500" x2="280" y2="500" stroke-width="13" />
          <path data-f="torso" d="M230 150 L235 300 L265 300 L270 150 Z" stroke-width="14" />
          <line data-f="neck" x1="250" y1="80" x2="250" y2="150" stroke-width="13" />
          <line data-f="uarm" x1="250" y1="150" x2="280" y2="202" stroke-width="18" />
          <line data-f="farm" x1="280" y1="202" x2="232" y2="150" stroke-width="15" />
          <circle data-f="hand" cx="232" cy="150" r="10" stroke="none" />
          <ellipse data-f="head" cx="250" cy="80" rx="23" ry="26" stroke="none" />
        </g>
        <g data-prop="db" opacity="0">
          <path data-prop="dbShape" fill="var(--rubber)" stroke="currentColor" stroke-width="6" stroke-linejoin="round" />
        </g>
        <path data-prop="handle" fill="none" stroke="currentColor" stroke-width="8" stroke-linecap="round" opacity="0" />
        <g fill="none" stroke="var(--violet-2)" stroke-width="2.5" stroke-dasharray="5 6" stroke-linecap="round" opacity="0.9">
          <polyline data-f="trackArm" points="250,150 280,202 232,150" />
          <polyline data-f="trackLeg" points="250,300 256,400 250,500" />
          <line data-f="trackTorso" x1="250" y1="150" x2="250" y2="300" />
        </g>
        <g fill="var(--violet-2)" stroke="var(--rubber)" stroke-width="2">
          <circle data-j="shoulder" cx="250" cy="150" r="6" />
          <circle data-j="elbow" cx="280" cy="202" r="6" />
          <circle data-j="wrist" cx="232" cy="150" r="6" />
          <circle data-j="hip" cx="250" cy="300" r="6" />
          <circle data-j="knee" cx="256" cy="400" r="6" />
          <circle data-j="ankle" cx="250" cy="500" r="6" />
        </g>
      </svg>

      <div class="tabs" role="tablist" aria-label="Exercises in the demo">
        {
          exercises.map(([id, name], i) => (
            <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-ex={id}>
              {name}<i></i>
            </button>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* Layout: copy left, stage right, both centred in the first fold. */
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: 100svh;
    padding-top: 104px;
    padding-bottom: 48px;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(55% 60% at 78% 8%, rgba(139, 92, 246, 0.22), transparent 65%),
      radial-gradient(40% 45% at 92% 70%, rgba(109, 63, 224, 0.16), transparent 70%),
      radial-gradient(45% 40% at 8% 96%, rgba(196, 181, 253, 0.07), transparent 70%);
    pointer-events: none;
  }
  .hero__in {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(32px, 5vw, 80px);
  }
  .hero__title {
    font-size: clamp(34px, 3.6vw, 56px);
    line-height: 1.02;
    max-width: 12ch;
  }
  .hero__sub {
    margin-top: 14px;
    font-size: clamp(22px, 1.9vw, 30px);
    font-weight: 800;
    font-variation-settings: 'wdth' 118;
    letter-spacing: -0.02em;
    color: var(--violet-2);
  }
  .hero__lead {
    margin-top: 20px;
    max-width: 40ch;
    font-size: 17px;
    color: var(--steel);
    text-wrap: pretty;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .hero__note {
    margin-top: 16px;
    font-size: 13.5px;
    color: var(--dim);
  }

  /* Stage: a floor line 56px up (the tab row sits on the floor below it). */
  .stage {
    --floor: 56px;
    position: relative;
    height: clamp(440px, 56vh, 580px);
    color: var(--chalk);
  }
  .stage::after {
    content: '';
    position: absolute;
    left: -12%;
    right: -12%;
    bottom: var(--floor);
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(196, 181, 253, 0.6) 30%, rgba(196, 181, 253, 0.6) 70%, transparent);
    box-shadow: 0 0 24px rgba(139, 92, 246, 0.5);
  }
  .stage__light {
    position: absolute;
    inset: -14% 12% var(--floor) 2%;
    background:
      radial-gradient(55% 95% at 50% 100%, rgba(236, 233, 225, 0.11), transparent 70%),
      radial-gradient(70% 50% at 50% 100%, rgba(139, 92, 246, 0.28), transparent 70%);
    pointer-events: none;
  }
  .stage::before {
    content: '';
    position: absolute;
    left: -12%;
    right: -12%;
    bottom: 0;
    height: var(--floor);
    background: linear-gradient(180deg, rgba(139, 92, 246, 0.12), transparent);
    pointer-events: none;
  }
  .chalk {
    position: absolute;
    bottom: var(--floor);
    color: var(--chalk);
    will-change: transform;
  }
  .chalk--rack {
    left: 3%;
    top: -6%;
    bottom: auto;
    height: calc(106% - var(--floor));
    width: auto;
    opacity: 0.2;
  }
  .chalk--plate {
    right: -3%;
    width: 24%;
    opacity: 0.2;
  }
  .chalk--plate2 {
    right: 6%;
    opacity: 0.12;
  }
  .chalk__label {
    font-family: var(--font);
    font-variation-settings: 'wdth' 125;
    font-weight: 800;
    font-size: 30px;
    fill: currentColor;
  }
  .figure {
    position: absolute;
    left: 0;
    bottom: var(--floor);
    height: calc(92% - var(--floor));
    width: auto;
    will-change: transform;
  }

  .set {
    position: absolute;
    right: 0;
    top: 0;
    z-index: 2;
    display: grid;
    justify-items: end;
    gap: 6px;
    text-align: right;
  }
  .set__name {
    font-size: 14px;
    font-weight: 600;
    color: var(--steel);
  }
  .set__count {
    font-size: clamp(48px, 5vw, 76px);
    line-height: 0.9;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .set__ticks {
    display: flex;
    gap: 5px;
  }
  .set__ticks i {
    width: 18px;
    height: 4px;
    border-radius: 2px;
    background: var(--iron-2);
    transition: background 0.3s ease;
  }
  .set__ticks i.is-on {
    background: var(--violet-2);
  }
  .set__label {
    font-size: 12.5px;
    color: var(--dim);
  }

  .cue {
    position: absolute;
    left: 50%;
    top: 60%;
    z-index: 3;
    padding: 9px 12px;
    border-radius: 8px;
    background: var(--violet);
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(6px);
  }
  .cue::after {
    content: '';
    position: absolute;
    left: -5px;
    top: 50%;
    width: 10px;
    height: 10px;
    background: inherit;
    transform: translateY(-50%) rotate(45deg);
    border-radius: 2px;
  }

  .tabs {
    position: absolute;
    inset: auto 0 0;
    height: var(--floor);
    display: flex;
    gap: 4px;
    align-items: center;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .tabs::-webkit-scrollbar {
    display: none;
  }
  .tabs button {
    position: relative;
    flex: 0 0 auto;
    padding: 7px 11px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--dim);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    overflow: hidden;
    transition:
      color 0.25s ease,
      background 0.25s ease;
  }
  .tabs button:hover {
    color: var(--steel);
    background: rgba(236, 233, 225, 0.04);
  }
  .tabs button[aria-selected='true'] {
    color: var(--chalk);
    background: var(--iron-2);
  }
  .tabs button i {
    position: absolute;
    inset: auto 0 0;
    height: 2px;
    background: var(--violet-2);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  @media (max-width: 960px) {
    .hero {
      align-items: start;
      padding-top: 96px;
      padding-bottom: 32px;
    }
    .hero__in {
      grid-template-columns: 1fr;
    }
    .hero__title {
      max-width: none;
    }
    .stage {
      height: clamp(400px, 100vw, 500px);
      margin-top: 8px;
    }
    .figure {
      height: calc(88% - var(--floor));
    }
    .set__count {
      font-size: 44px;
    }
    .cue {
      left: 46%;
      top: 56%;
      font-size: 12px;
    }
    .chalk--plate {
      width: 30%;
      right: -8%;
    }
    .chalk--plate2 {
      right: 4%;
    }
    .tabs {
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
    }
  }
</style>
