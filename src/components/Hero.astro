---
const base = import.meta.env.BASE_URL;
const screens = [
  {
    src: 'm-dark-home-train.webp',
    alt: 'SpotAI home screen during a workout: Back and biceps session, next up Lat pulldown 3 by 10, day streak and visits this week',
  },
  {
    src: 'm-dark-coach.webp',
    alt: 'SpotAI AI coach screen: pose tracking preview of a squat with Runs on your phone label, exercise Squat selected',
  },
  {
    src: 'm-dark-leaderboard.webp',
    alt: 'SpotAI gym leaderboard with tabs for visits, kilograms and streak and the member’s own place highlighted',
  },
];
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="wrap hero__in">
    <div class="hero__copy">
      <h1 id="hero-title" class="hero__title wide">Nobody checking your form. No plan for today. Dues chased on WhatsApp.</h1>
      <p class="hero__sub">SpotAI fixes all three.</p>
      <p class="lead hero__lead">
        The AI gym app for Indian gyms. Members get a coach that checks their squat on the phone camera, a workout log,
        their gym’s leaderboard and a buddy to train with. Owners get arrivals, dues and UPI payments in one console.
        Video never leaves the phone.
      </p>
      <div class="hero__cta">
        <a href="#download" class="btn btn--primary">Get early access</a>
        <a href="#owners" class="btn btn--ghost">For gym owners</a>
      </div>
      <ul class="hero__proof" aria-label="What you get">
        <li>Form check on your phone</li>
        <li>Opt-in gym leaderboard</li>
        <li>Dues paid with UPI</li>
      </ul>
    </div>

    <div class="hero__stage" data-stage>
      <div class="stage__glow" aria-hidden="true"></div>
      <div class="stage__floor" aria-hidden="true"></div>

      <div class="phone hero__phone" data-phone>
        {
          screens.map((s, i) => (
            <img
              src={`${base}shots/${s.src}`}
              width="640"
              height="1385"
              alt={s.alt}
              class:list={['hero__screen', { 'is-on': i === 0 }]}
              fetchpriority={i === 0 ? 'high' : 'auto'}
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
              data-screen={i}
            />
          ))
        }
      </div>

      <!-- Three moments from the app, one per screen. Animated in sync once the page has loaded. -->
      <div class="moment moment--coach" data-moment="1">
        <p class="moment__head"><i class="moment__icon"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h3l2-2h6l2 2h3v12H4z"/><circle cx="12" cy="13" r="3.5"/></svg></i><span>AI coach</span><span class="moment__tag">Squat, set 2</span></p>
        <p class="moment__big"><b data-rep>0</b><span>reps</span></p>
        <ul class="moment__flags">
          <li class="is-ok">Depth</li>
          <li class="is-ok">Knees</li>
          <li class="is-cue" data-cue>Lean</li>
        </ul>
        <p class="moment__note">One tip per set, from your trainer’s templates.</p>
      </div>

      <div class="moment moment--board" data-moment="2">
        <p class="moment__head"><i class="moment__icon"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 4h10v5a5 5 0 0 1-10 0z"/><path d="M7 6H4v2a3 3 0 0 0 3 3M17 6h3v2a3 3 0 0 1-3 3M12 14v4M8 20h8"/></svg></i><span>Leaderboard</span><span class="moment__tag">Visits, this week</span></p>
        <ol class="moment__rows" data-rows>
          <li><span>Diya</span><b>3</b></li>
          <li><span>Arjun</span><b>2</b></li>
          <li class="is-you" data-you><span>You</span><b data-visits>1</b></li>
        </ol>
      </div>

      <div class="moment moment--owner" data-moment="0">
        <p class="moment__head"><i class="moment__icon"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 4h12M6 9h12M6 4h3a4.5 4.5 0 0 1 0 9H6l8 7"/></svg></i><span>Owner console</span><span class="moment__tag">Today</span></p>
        <p class="moment__kv"><span>Collected this month</span><b>₹9,000</b></p>
        <p class="moment__kv"><span>Overdue, 1 member</span><b>₹2,000</b></p>
        <p class="moment__due"><span class="moment__paid" data-paid>Paid via UPI</span></p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: 100svh;
    padding-top: 120px;
    padding-bottom: 72px;
    overflow: hidden;
  }
  .hero__in {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    align-items: center;
    gap: clamp(32px, 5vw, 80px);
  }
  .hero__title {
    font-size: clamp(34px, 3.9vw, 58px);
    line-height: 1.04;
    letter-spacing: -0.02em;
  }
  .hero__sub {
    margin-top: 18px;
    font-size: clamp(26px, 2.6vw, 38px);
    font-weight: 800;
    font-variation-settings: 'wdth' 118;
    letter-spacing: -0.02em;
    color: var(--violet-2);
  }
  .hero__lead {
    margin-top: 24px;
    max-width: 52ch;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }
  .hero__proof {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
    color: var(--steel);
  }
  .hero__proof li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .hero__proof li::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--violet-2);
  }

  /* Stage */
  .hero__stage {
    position: relative;
    height: clamp(560px, 72vh, 720px);
    perspective: 1400px;
  }
  .stage__glow {
    position: absolute;
    left: 50%;
    top: 48%;
    width: 120%;
    aspect-ratio: 1;
    translate: -50% -50%;
    background:
      radial-gradient(closest-side, rgba(139, 92, 246, 0.28), rgba(139, 92, 246, 0.06) 50%, transparent 70%),
      radial-gradient(40% 40% at 20% 15%, rgba(236, 233, 225, 0.06), transparent 70%);
    pointer-events: none;
  }
  .stage__floor {
    position: absolute;
    left: 10%;
    right: 10%;
    bottom: 4%;
    height: 60px;
    background: radial-gradient(50% 100% at 50% 100%, rgba(139, 92, 246, 0.35), transparent 70%);
    border-bottom: 1px solid rgba(196, 181, 253, 0.25);
    pointer-events: none;
  }
  .hero__phone {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(280px, 52%);
    translate: -50% -52%;
    z-index: 1;
    transform: rotateY(-9deg) rotateX(3deg);
    transform-style: preserve-3d;
    box-shadow:
      inset 0 0 0 1px rgba(236, 233, 225, 0.28),
      inset 0 0 0 3px #0b0c0f,
      inset 0 0 0 4px rgba(236, 233, 225, 0.08),
      0 0 0 1px rgba(0, 0, 0, 0.8),
      0 60px 120px -40px rgba(139, 92, 246, 0.5),
      0 50px 80px -30px rgba(0, 0, 0, 0.95);
  }
  .hero__phone::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.35), transparent 35%, transparent 65%, rgba(139, 92, 246, 0.5));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    padding: 1.5px;
    pointer-events: none;
  }
  .hero__phone img {
    position: absolute;
    inset: 9px;
    width: calc(100% - 18px);
    height: calc(100% - 18px);
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .hero__phone img.is-on {
    opacity: 1;
  }

  .moment {
    position: absolute;
    z-index: 2;
    width: 208px;
    padding: 14px 16px 15px;
    border-radius: 18px;
    background: linear-gradient(180deg, #24272f, #191b21);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.09),
      0 0 0 1px rgba(236, 233, 225, 0.12),
      0 30px 50px -24px rgba(0, 0, 0, 0.95);
    opacity: 0.86;
    transform: scale(0.96);
    transition:
      opacity 0.5s ease,
      transform 0.5s var(--ease),
      box-shadow 0.5s ease;
  }
  .moment.is-active {
    opacity: 1;
    transform: translateY(-4px) scale(1.03);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.12),
      0 0 0 1px rgba(196, 181, 253, 0.6),
      0 0 50px -12px rgba(139, 92, 246, 0.7),
      0 30px 50px -24px rgba(0, 0, 0, 0.95);
  }
  .moment__head {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12.5px;
    font-weight: 700;
    color: var(--chalk);
    white-space: nowrap;
  }
  .moment__icon {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 7px;
    background: rgba(139, 92, 246, 0.2);
    color: var(--violet-2);
  }
  .moment__tag {
    margin-left: auto;
    font-weight: 500;
    font-size: 11.5px;
    color: var(--dim);
  }
  .moment--coach {
    left: -5%;
    top: 7%;
  }
  .moment--board {
    right: -6%;
    top: 40%;
  }
  .moment--owner {
    left: -3%;
    bottom: 9%;
  }
  .moment__big {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-top: 10px;
  }
  .moment__big b {
    font-size: 44px;
    font-weight: 800;
    font-variation-settings: 'wdth' 118;
    letter-spacing: -0.03em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .moment__big span {
    font-size: 13px;
    color: var(--steel);
  }
  .moment__flags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
    font-size: 11.5px;
    font-weight: 600;
  }
  .moment__flags li {
    padding: 4px 9px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--steel);
  }
  .moment__flags .is-ok {
    color: var(--go);
    background: rgba(74, 222, 128, 0.1);
  }
  .moment__flags .is-cue {
    color: var(--warn);
    background: rgba(251, 191, 36, 0.1);
    opacity: 0;
  }
  .moment__note {
    margin-top: 10px;
    font-size: 11.5px;
    line-height: 1.4;
    color: var(--dim);
  }
  .moment__rows {
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 4px;
    font-size: 13px;
  }
  .moment__rows li {
    display: flex;
    justify-content: space-between;
    padding: 6px 10px;
    border-radius: 8px;
    background: rgba(236, 233, 225, 0.045);
    color: var(--steel);
  }
  .moment__rows li b {
    font-variant-numeric: tabular-nums;
    color: var(--chalk);
  }
  .moment__rows .is-you {
    color: var(--chalk);
    background: rgba(139, 92, 246, 0.24);
    box-shadow: inset 0 0 0 1px rgba(196, 181, 253, 0.4);
  }
  .moment__kv {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    margin-top: 8px;
    font-size: 12.5px;
    color: var(--steel);
  }
  .moment__kv b {
    color: var(--chalk);
    font-variant-numeric: tabular-nums;
  }
  .moment__kv + .moment__kv {
    margin-top: 6px;
    padding-top: 6px;
    border-top: 1px solid var(--line);
  }
  .moment__due {
    display: flex;
    justify-content: flex-end;
    margin-top: 8px;
    min-height: 22px;
  }
  .moment__paid {
    padding: 4px 9px;
    border-radius: 999px;
    background: rgba(74, 222, 128, 0.14);
    color: var(--go);
    font-size: 11.5px;
    font-weight: 700;
    opacity: 0;
    transform: scale(0.9);
  }

  @media (max-width: 960px) {
    .hero {
      padding-top: 96px;
      padding-bottom: 40px;
    }
    .hero__in {
      grid-template-columns: 1fr;
    }
    .hero__stage {
      height: auto;
      display: grid;
      gap: 12px;
      padding-top: 8px;
    }
    .hero__phone {
      position: relative;
      left: auto;
      top: auto;
      translate: none;
      transform: none;
      width: min(260px, 70%);
      margin: 0 auto;
      aspect-ratio: 390 / 844;
    }
    .stage__floor {
      display: none;
    }
    .stage__glow {
      top: 36%;
      width: 100%;
    }
    .moment {
      position: static;
      width: auto;
      opacity: 1;
      transform: none;
    }
    .moment.is-active {
      transform: none;
    }
    .hero__stage .moment--owner {
      order: 1;
    }
    .hero__stage .moment--coach {
      order: 2;
    }
    .hero__stage .moment--board {
      order: 3;
    }
  }
  @media (max-width: 600px) {
    .hero__title {
      font-size: 30px;
    }
    .hero__sub {
      font-size: 24px;
    }
  }
</style>
