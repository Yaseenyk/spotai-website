---
const exercises = [
  ['squat', 'Squat'],
  ['deadlift', 'Deadlift'],
  ['bench', 'Bench press'],
  ['curl', 'Biceps curl'],
  ['pulldown', 'Lat pulldown'],
  ['press', 'Overhead press'],
];
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="wrap hero__in">
    <div class="hero__copy">
      <h1 id="hero-title" class="hero__title wide">
        <span data-hero-line>The AI gym buddy</span>
        <span data-hero-line>for Indian gyms.</span>
      </h1>
      <p class="lead hero__lead" data-hero-line>
        Lean your phone on the rack and squat: SpotAI counts the reps and calls the form, on the phone, with no video
        sent anywhere. Every set logged, a leaderboard for your gym, a buddy to train with. Owners get arrivals, dues
        and UPI in one console.
      </p>
      <div class="hero__cta" data-hero-line>
        <a href="#download" class="btn btn--primary">Get early access</a>
        <a href="#owners" class="btn btn--ghost">For gym owners</a>
      </div>
      <p class="hero__note" data-hero-line>
        In private demo with partner gyms in Hyderabad. Play Store and App Store links on launch day.
      </p>
    </div>

    <div class="hero__stage" data-stage>
      <!-- Chalk kit on the floor; drawn on load. -->
      <div class="stage__light" aria-hidden="true"></div>
      <div class="stage__pool" aria-hidden="true"></div>
      <svg class="chalk chalk--plate2" viewBox="0 0 320 320" aria-hidden="true" data-kit data-depth="0.35">
        <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" data-chalk>
          <circle cx="160" cy="160" r="150" />
          <circle cx="160" cy="160" r="112" />
          <circle cx="160" cy="160" r="30" />
        </g>
        <text x="160" y="76" text-anchor="middle" class="chalk__label">15</text>
      </svg>
      <svg class="chalk chalk--plate" viewBox="0 0 320 320" aria-hidden="true" data-kit data-depth="0.5">
        <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" data-chalk>
          <circle cx="160" cy="160" r="150" />
          <circle cx="160" cy="160" r="112" />
          <circle cx="160" cy="160" r="30" />
          <path d="M160 10 v24 M160 286 v24 M10 160 h24 M286 160 h24" />
        </g>
        <text x="160" y="76" text-anchor="middle" class="chalk__label">20</text>
      </svg>
      <svg class="chalk chalk--rack" viewBox="0 0 60 600" aria-hidden="true">
        <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" data-chalk>
          <path d="M18 0 V600 M42 0 V600" />
          {[40, 100, 160, 220, 280, 340, 400, 460, 520].map((y) => <circle cx="30" cy={y} r="5" />)}
        </g>
      </svg>

      <div class="hero__set" data-rep-box>
        <span class="hero__set-name" data-set-name>Squat</span>
        <b class="wide" data-rep>0</b>
        <span class="hero__ticks" aria-hidden="true" data-ticks><i></i><i></i><i></i><i></i></span>
        <span class="hero__set-label">reps this set</span>
      </div>
      <div class="hero__flag" data-hflag>Knees out over your toes</div>

      <!-- The lifter. Side view; every joint is driven by the exercise reel in motion.ts. -->
      <svg class="figure" viewBox="0 0 520 560" aria-hidden="true" data-figure>
        <ellipse cx="270" cy="508" rx="130" ry="9" fill="currentColor" opacity="0.1" />
        <!-- gear behind the lifter -->
        <g data-gear="bench" opacity="0">
          <rect x="110" y="372" width="300" height="22" rx="6" fill="var(--iron-2)" stroke="var(--line-2)" />
          <rect x="150" y="394" width="14" height="106" fill="var(--iron-2)" />
          <rect x="356" y="394" width="14" height="106" fill="var(--iron-2)" />
        </g>
        <g data-gear="seat" opacity="0">
          <rect x="190" y="392" width="120" height="20" rx="6" fill="var(--iron-2)" stroke="var(--line-2)" />
          <rect x="242" y="412" width="16" height="88" fill="var(--iron-2)" />
          <rect x="292" y="356" width="80" height="16" rx="6" fill="var(--iron-2)" stroke="var(--line-2)" />
        </g>
        <line data-gear="cable" x1="300" y1="0" x2="300" y2="100" stroke="var(--steel)" stroke-width="3" opacity="0" />
        <circle data-prop="plate" cx="0" cy="0" r="46" fill="var(--rubber)" stroke="currentColor" stroke-width="7" opacity="0" />
        <circle data-prop="plate2" cx="0" cy="0" r="46" fill="var(--rubber)" stroke="currentColor" stroke-width="7" opacity="0" />
        <defs>
          <linearGradient id="skin" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#f3f1ea" />
            <stop offset="1" stop-color="#d6d2c7" />
          </linearGradient>
          <linearGradient id="kitgrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#3b3650" />
            <stop offset="1" stop-color="#2a2738" />
          </linearGradient>
        </defs>
        <!-- back limbs, dimmer: depth -->
        <g fill="#b7b3aa" stroke="#b7b3aa" stroke-width="2" stroke-linejoin="round" opacity="0.62">
          <path data-f="thighB" /><path data-f="shortsB" fill="#1c1e25" stroke="#1c1e25" /><circle data-f="kneeB" r="12" /><path data-f="calfB" /><path data-f="footB" />
          <path data-f="uarmB" /><circle data-f="elbowB" r="9" /><path data-f="farmB" /><circle data-f="handB" r="9" />
        </g>
        <!-- body -->
        <g fill="url(#skin)" stroke="url(#skin)" stroke-width="2" stroke-linejoin="round">
          <path data-f="torso" />
          <path data-f="shirt" fill="url(#kitgrad)" stroke="none" />
          <circle data-f="hipJ" r="18" fill="#262932" stroke="none" />
          <path data-f="thigh" /><path data-f="shorts" fill="#262932" stroke="#262932" /><circle data-f="knee" r="13" /><path data-f="calf" /><circle data-f="ankle" r="8" />
          <path data-f="foot" fill="#e3e0d8" stroke="none" /><path data-f="sole" fill="#2b2d34" stroke="none" />
          <path data-f="neck" />
          <g data-f="headG">
            <path d="M-18 -24 Q0 -32 14 -22 Q23 -12 21 -3 L27 3 L22 7 Q22 13 17 17 Q10 25 -2 23 Q-18 17 -21 0 Q-23 -14 -18 -24 Z" />
            <path d="M-20 -22 Q0 -34 17 -20 Q10 -17 0 -19 Q-14 -17 -20 -2 Q-24 -12 -20 -22 Z" fill="#2b2d34" stroke="none" />
            <ellipse cx="-5" cy="1" rx="3.5" ry="5" fill="#cfcbc0" stroke="none" />
            <circle cx="12" cy="-6" r="2" fill="#2b2d34" stroke="none" />
          </g>
          <circle data-f="shoulderJ" r="15" />
        </g>
        <!-- front arm, edged so it separates from the chest -->
        <g fill="url(#skin)" stroke="var(--rubber)" stroke-width="2.5" stroke-linejoin="round">
          <path data-f="uarm" /><circle data-f="elbow" r="10" /><path data-f="farm" /><circle data-f="hand" r="9" />
        </g>
        <g data-prop="db" opacity="0">
          <path data-prop="dbShape" d="" fill="var(--rubber)" stroke="currentColor" stroke-width="6" stroke-linejoin="round" />
        </g>
        <path data-prop="handle" d="" fill="none" stroke="currentColor" stroke-width="8" stroke-linecap="round" opacity="0" />
        <!-- what the camera tracks: the landmark skeleton over the body -->
        <g fill="none" stroke="var(--violet-2)" stroke-width="2.5" stroke-dasharray="5 6" stroke-linecap="round" opacity="0.9">
          <polyline data-f="trackArm" />
          <polyline data-f="trackLeg" />
          <line data-f="trackTorso" />
        </g>
        <g fill="var(--violet-2)" stroke="var(--rubber)" stroke-width="2">
          <circle data-j="shoulder" r="6" />
          <circle data-j="elbow" r="6" />
          <circle data-j="wrist" r="6" />
          <circle data-j="hip" r="6" />
          <circle data-j="knee" r="6" />
          <circle data-j="ankle" r="6" />
        </g>
      </svg>

      <div class="hero__tabs" role="tablist" aria-label="Exercises in the demo">
        {
          exercises.map(([id, name], i) => (
            <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-ex={id}>
              {name}<i></i>
            </button>
          ))
        }
      </div>
    </div>
  </div>

  <div class="hero__floor" aria-hidden="true"></div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: end;
    padding-top: 120px;
    padding-bottom: 56px;
    overflow: hidden;
  }
  .hero__in {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    align-items: end;
    gap: clamp(24px, 4vw, 64px);
  }
  .hero__copy {
    padding-bottom: clamp(56px, 9vh, 112px);
  }
  .hero__title {
    font-size: clamp(42px, 5.6vw, 84px);
    line-height: 0.96;
  }
  .hero__title span {
    display: block;
  }
  .hero__lead {
    margin-top: 28px;
    max-width: 48ch;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }
  .hero__note {
    margin-top: 22px;
    font-size: 14px;
    color: var(--dim);
    max-width: 44ch;
  }

  /* Stage: the lifter stands on the floor line; the tab row sits on the floor below. */
  .hero__stage {
    position: relative;
    height: clamp(500px, 68vh, 680px);
    color: var(--chalk);
  }
  .hero__floor {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 56px;
    height: 1px;
    background: var(--line-2);
  }
  .chalk {
    position: absolute;
    color: var(--chalk);
    opacity: 0.26;
    will-change: transform;
  }
  .chalk--plate {
    right: -2%;
    bottom: 56px;
    width: 30%;
  }
  .chalk--plate2 {
    right: 10%;
    bottom: 56px;
    width: 30%;
    opacity: 0.16;
  }
  .stage__light {
    position: absolute;
    left: 10%;
    right: 18%;
    top: -10%;
    bottom: 56px;
    background: radial-gradient(60% 90% at 50% 100%, rgba(236, 233, 225, 0.075), transparent 70%);
    pointer-events: none;
  }
  .stage__pool {
    position: absolute;
    left: 6%;
    right: 14%;
    bottom: 50px;
    height: 14px;
    background: radial-gradient(closest-side, rgba(236, 233, 225, 0.22), transparent);
    pointer-events: none;
  }
  .chalk--rack {
    left: 8%;
    top: -6%;
    height: calc(106% - 56px);
    width: auto;
    opacity: 0.2;
  }
  .chalk__label {
    font-family: var(--font);
    font-variation-settings: 'wdth' 125;
    font-weight: 800;
    font-size: 30px;
    fill: currentColor;
  }
  .figure {
    position: absolute;
    left: 4%;
    bottom: 56px;
    height: calc(94% - 56px);
    width: auto;
    color: var(--chalk);
    filter: drop-shadow(0 24px 24px rgba(0, 0, 0, 0.45));
    will-change: transform;
  }
  .hero__set {
    position: absolute;
    right: 0;
    top: 0;
    display: grid;
    justify-items: end;
    gap: 6px;
    text-align: right;
    z-index: 2;
  }
  .hero__set-name {
    font-size: 14px;
    font-weight: 600;
    color: var(--steel);
  }
  .hero__set b {
    font-size: clamp(56px, 6vw, 88px);
    line-height: 0.9;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    color: var(--chalk);
  }
  .hero__ticks {
    display: flex;
    gap: 5px;
  }
  .hero__ticks i {
    width: 18px;
    height: 4px;
    border-radius: 2px;
    background: var(--iron-2);
    transition: background 0.3s ease;
  }
  .hero__ticks i.is-on {
    background: var(--violet-2);
  }
  .hero__set-label {
    font-size: 12.5px;
    color: var(--dim);
  }
  .hero__flag {
    position: absolute;
    left: 2%;
    top: 52%;
    padding: 9px 12px;
    border-radius: 8px;
    background: var(--violet);
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(6px);
    z-index: 3;
  }
  .hero__flag::after {
    content: '';
    position: absolute;
    right: -5px;
    top: 50%;
    width: 10px;
    height: 10px;
    background: inherit;
    transform: translateY(-50%) rotate(45deg);
    border-radius: 2px;
  }
  .hero__tabs {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 56px;
    display: flex;
    gap: 4px;
    align-items: center;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .hero__tabs::-webkit-scrollbar {
    display: none;
  }
  .hero__tabs button {
    position: relative;
    flex: 0 0 auto;
    padding: 7px 11px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--dim);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    overflow: hidden;
    transition:
      color 0.25s ease,
      background 0.25s ease;
  }
  .hero__tabs button:hover {
    color: var(--steel);
    background: rgba(236, 233, 225, 0.04);
  }
  .hero__tabs button[aria-selected='true'] {
    color: var(--chalk);
    background: var(--iron-2);
  }
  .hero__tabs button i {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--violet-2);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  @media (max-width: 960px) {
    .hero {
      padding-top: 96px;
      padding-bottom: 40px;
      align-items: start;
    }
    .hero__floor {
      bottom: 40px;
    }
    .hero__in {
      grid-template-columns: 1fr;
    }
    .hero__copy {
      padding-bottom: 8px;
    }
    .hero__stage {
      height: clamp(420px, 108vw, 520px);
    }
    .figure {
      height: calc(90% - 56px);
    }
    .hero__set b {
      font-size: 48px;
    }
    .hero__flag {
      left: 0;
      top: 48%;
      font-size: 12px;
    }
    .chalk--rack {
      left: 2%;
    }
    .chalk--plate {
      width: 34%;
      right: -6%;
    }
    .chalk--plate2 {
      width: 34%;
      right: 8%;
    }
    .hero__tabs {
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
    }
  }
</style>
