---
import { strings } from '../i18n/strings';
import { langOf, localize } from '../i18n/config';
const code = langOf(Astro.url.pathname);
const T = strings(code);
const t = T.privacy;
// Default state of each switch in the illustrated privacy centre.
const consents = (
  [
    ['camera', true],
    ['clips', false],
    ['face', false],
    ['matching', true],
    ['chat', true],
    ['reminders', true],
  ] as const
).map(([k, on]) => [t.consents[k], on] as const);
---

<section class="section privacy" id="privacy" aria-labelledby="privacy-title">
  <div class="wrap privacy__in">
    <div class="privacy__copy">
      <h2 id="privacy-title">{t.title}</h2>
      <p class="lead">{t.lead}</p>
      <a class="more-link" href={localize('/features/privacy/', code)}>{T.common.seeFeature}</a>
      <ul class="points" role="list">
        {
          t.points.map((p) => (
            <li>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="centre" aria-label={t.centreLabel}>
      <p class="centre__title">{t.centreTitle}</p>
      <p class="centre__sub">{T.common.inApp}</p>
      <ul class="toggles" role="list">
        {
          consents.map(([label, on]) => (
            <li class:list={{ 'is-on': on }}>
              <span>{label}</span>
              <i aria-hidden="true" />
              <b class="sr-only">{on ? T.common.on : T.common.off}</b>
            </li>
          ))
        }
      </ul>
      <div class="centre__actions">
        <span>{t.exportData}</span>
        <span>{t.deleteAccount}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .privacy__in {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }
  .privacy__copy h2 {
    font-size: clamp(30px, 3.2vw, 44px);
  }
  .privacy__copy .lead {
    margin-top: 16px;
  }
  .points {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 28px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }
  .points li {
    padding: 16px 0 18px;
    border-top: 1px solid var(--line);
  }
  .points h3 {
    font-size: 16.5px;
    font-variation-settings: 'wdth' 105;
    letter-spacing: -0.01em;
  }
  .points p {
    margin-top: 6px;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--steel);
  }

  .centre {
    position: sticky;
    top: 96px;
    padding: 22px 22px 20px;
    border-radius: 20px;
    background: linear-gradient(180deg, #1f2129, #171920);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.07),
      0 0 0 1px var(--line),
      0 30px 50px -30px rgba(0, 0, 0, 0.9);
  }
  .centre__title {
    font-size: 20px;
    font-weight: 800;
    font-variation-settings: 'wdth' 110;
  }
  .centre__sub {
    margin-top: 2px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--violet-2);
  }
  .toggles {
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }
  .toggles li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 0;
    border-top: 1px solid var(--line);
    font-size: 15px;
    font-weight: 600;
  }
  .toggles i {
    position: relative;
    width: 42px;
    height: 24px;
    border-radius: 999px;
    background: var(--iron-2);
    transition: background 0.3s ease;
  }
  .toggles i::after {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--chalk-2);
    transition: transform 0.3s var(--ease);
  }
  .toggles .is-on i {
    background: var(--violet);
  }
  .toggles .is-on i::after {
    background: #fff;
    transform: translateX(18px);
  }
  .centre__actions {
    display: flex;
    gap: 8px;
    margin-top: 16px;
  }
  .centre__actions span {
    flex: 1;
    padding: 10px 12px;
    border-radius: 10px;
    box-shadow: inset 0 0 0 1px var(--line-2);
    font-size: 13.5px;
    font-weight: 600;
    text-align: center;
    color: var(--chalk);
  }

  @media (max-width: 960px) {
    .privacy__in {
      grid-template-columns: 1fr;
    }
    .centre {
      position: static;
      max-width: 440px;
    }
  }
  @media (max-width: 600px) {
    .points {
      grid-template-columns: 1fr;
    }
  }
</style>
