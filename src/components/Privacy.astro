---
const base = import.meta.env.BASE_URL;
const consents = [
  ['Camera coaching', true],
  ['Save my clips', false],
  ['Face check-in', false],
  ['Buddy matching', true],
  ['Chat', true],
  ['Dues reminders', true],
] as const;
const points = [
  ['Frames never leave the phone', 'Pose tracking runs on the device. The server only ever gets rep counts and flags.'],
  ['One switch per purpose', 'Camera, clips, face, matching, chat and reminders are separate opt-ins, each with the notice version recorded.'],
  ['Export or delete from the app', 'A JSON of everything you have, or the whole account gone. No email to support.'],
  ['Complaints get a reference', 'File from the app, get a number, and the gym has to answer. As India’s DPDP Act expects.'],
  ['Language models behind a gate', 'Any model call goes through a gateway that strips identity and checks consent first, with template fallback.'],
  ['Adults only', 'Camera features and the community switch off for members under 18.'],
];
---

<section class="section privacy" id="privacy" aria-labelledby="privacy-title">
  <div class="wrap privacy__in">
    <div class="privacy__copy">
      <h2 id="privacy-title">Worried where your camera footage goes? Nowhere.</h2>
      <p class="lead">
        A gym app sees your camera, your attendance and sometimes your face. Each one is a separate decision you
        make, not a wall of text you tap through once.
      </p>
      <a class="more-link" href={`${base}features/privacy/`}>How privacy works in SpotAI</a>
      <ul class="points" role="list">
        {
          points.map(([t, b]) => (
            <li>
              <h3>{t}</h3>
              <p>{b}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="centre" aria-label="The privacy centre in the app">
      <p class="centre__title">Privacy centre</p>
      <p class="centre__sub">In the SpotAI app</p>
      <ul class="toggles" role="list">
        {
          consents.map(([label, on]) => (
            <li class:list={{ 'is-on': on }}>
              <span>{label}</span>
              <i aria-hidden="true" />
              <b class="sr-only">{on ? 'on' : 'off'}</b>
            </li>
          ))
        }
      </ul>
      <div class="centre__actions">
        <span>Export my data</span>
        <span>Delete my account</span>
      </div>
    </div>
  </div>
</section>

<style>
  .privacy__in {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }
  .privacy__copy h2 {
    font-size: clamp(30px, 3.2vw, 44px);
  }
  .privacy__copy .lead {
    margin-top: 16px;
  }
  .points {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 28px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }
  .points li {
    padding: 16px 0 18px;
    border-top: 1px solid var(--line);
  }
  .points h3 {
    font-size: 16.5px;
    font-variation-settings: 'wdth' 105;
    letter-spacing: -0.01em;
  }
  .points p {
    margin-top: 6px;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--steel);
  }

  .centre {
    position: sticky;
    top: 96px;
    padding: 22px 22px 20px;
    border-radius: 20px;
    background: linear-gradient(180deg, #1f2129, #171920);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.07),
      0 0 0 1px var(--line),
      0 30px 50px -30px rgba(0, 0, 0, 0.9);
  }
  .centre__title {
    font-size: 20px;
    font-weight: 800;
    font-variation-settings: 'wdth' 110;
  }
  .centre__sub {
    margin-top: 2px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--violet-2);
  }
  .toggles {
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }
  .toggles li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 0;
    border-top: 1px solid var(--line);
    font-size: 15px;
    font-weight: 600;
  }
  .toggles i {
    position: relative;
    width: 42px;
    height: 24px;
    border-radius: 999px;
    background: var(--iron-2);
    transition: background 0.3s ease;
  }
  .toggles i::after {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--chalk-2);
    transition: transform 0.3s var(--ease);
  }
  .toggles .is-on i {
    background: var(--violet);
  }
  .toggles .is-on i::after {
    background: #fff;
    transform: translateX(18px);
  }
  .centre__actions {
    display: flex;
    gap: 8px;
    margin-top: 16px;
  }
  .centre__actions span {
    flex: 1;
    padding: 10px 12px;
    border-radius: 10px;
    box-shadow: inset 0 0 0 1px var(--line-2);
    font-size: 13.5px;
    font-weight: 600;
    text-align: center;
    color: var(--chalk);
  }

  @media (max-width: 960px) {
    .privacy__in {
      grid-template-columns: 1fr;
    }
    .centre {
      position: static;
      max-width: 440px;
    }
  }
  @media (max-width: 600px) {
    .points {
      grid-template-columns: 1fr;
    }
  }
</style>
