---
// A real app screenshot in its device: a phone for the member app, a browser window for the owner console.
import type { Shot } from '../features';
interface Props {
  shot: Shot;
  eager?: boolean;
}
const { shot, eager = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---

{
  shot.kind === 'phone' ? (
    <div class="phone">
      <img src={`${base}shots/${shot.src}`} width="640" height="1385" alt={shot.alt} loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : 'auto'} />
    </div>
  ) : (
    <div class="browser">
      <div class="browser__bar" aria-hidden="true">
        <i />
        <i />
        <i />
        <span>owner.spotai.app</span>
      </div>
      <div class="browser__view">
        <img src={`${base}shots/${shot.src}`} width="1600" height="1000" alt={shot.alt} loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : 'auto'} />
      </div>
    </div>
  )
}

<style>
  .browser {
    width: 100%;
    border-radius: 12px;
    background: #1b1d24;
    box-shadow:
      0 0 0 1px rgba(236, 233, 225, 0.16),
      0 40px 70px -40px rgba(0, 0, 0, 0.95);
    overflow: hidden;
  }
  .browser__bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 10px;
    background: #23262e;
  }
  .browser__bar i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #4a4f5c;
  }
  .browser__bar span {
    margin-left: 8px;
    padding: 2px 10px;
    border-radius: 6px;
    background: #141518;
    font-size: 10px;
    color: #8d93a1;
  }
  .browser__view {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #141518;
  }
  .browser__view img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
