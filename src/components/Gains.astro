---
const base = import.meta.env.BASE_URL;
const cards = [
  {
    problem: 'Progress you can’t see',
    fix: 'Lifetime kilograms, reps and workouts, personal bests, and badges from 1,000 kg lifted up to 100,000.',
    src: 'm-dark-gains.webp',
    alt: 'Gains screen: lifetime kilograms lifted, reps and workouts, personal bests and milestone badges',
  },
  {
    problem: 'Nobody notices you showed up',
    fix: 'Three gym boards: visits, kilos and streak, this week. Opt in with your first name. Leave any time and your numbers go private again.',
    src: 'm-dark-leaderboard.webp',
    alt: 'Gym leaderboard with tabs for Visits, Kg lifted and Streak, a podium of Diya, Sana and Arjun, and the member’s own place highlighted',
  },
  {
    problem: 'Training alone',
    fix: 'Buddy suggestions with the reason: same start, same hours, a shared goal. Chat and groups, each a separate consent, adults only.',
    src: 'm-dark-connect.webp',
    alt: 'Buddies screen with a suggested training partner and why they match, plus requests, chats and groups',
  },
];
---

<section class="section gains" id="gains" aria-labelledby="gains-title">
  <div class="wrap">
    <div class="gains__head">
      <h2 id="gains-title">Lose steam after week two? Your gym keeps you coming back.</h2>
      <p class="lead">The kilos add up, the streak shows, and the people at your gym see you turn up.</p>
      <a class="more-link" href={`${base}features/leaderboard/`}>Leaderboard, gains and buddies</a>
    </div>

    <ul class="cards" role="list">
      {
        cards.map((c) => (
          <li class="card">
            <div class="card__phone">
              <div class="phone">
                <img src={`${base}shots/${c.src}`} width="640" height="1385" alt={c.alt} loading="lazy" decoding="async" />
              </div>
            </div>
            <div class="card__text">
              <span class="card__app">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="6" y="2.5" width="12" height="19" rx="2.5" /><path d="M10 18h4" /></svg>
                In the SpotAI app
              </span>
              <h3>{c.problem}</h3>
              <p>{c.fix}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .gains__head {
    max-width: 680px;
    margin-bottom: clamp(32px, 5vw, 56px);
  }
  .gains__head h2 {
    font-size: clamp(30px, 3.4vw, 46px);
  }
  .gains__head .lead {
    margin-top: 14px;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .card {
    display: grid;
    grid-template-rows: auto 1fr;
    padding: 0;
    border-radius: 20px;
    background: linear-gradient(180deg, #1f2129, #171920);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.07),
      0 0 0 1px var(--line),
      0 30px 50px -30px rgba(0, 0, 0, 0.9);
    overflow: hidden;
  }
  .card__phone {
    position: relative;
    height: 390px;
    padding: 26px 0 0;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    overflow: hidden;
    background: radial-gradient(70% 60% at 50% 100%, rgba(139, 92, 246, 0.32), transparent 70%);
  }
  .card__phone .phone {
    width: 74%;
    flex: 0 0 auto;
  }
  .card__phone::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 30%;
    background: linear-gradient(180deg, transparent, rgba(23, 25, 32, 0.95));
    pointer-events: none;
  }
  .card__text {
    padding: 18px 22px 24px;
  }
  .card__app {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--violet-2);
  }
  .card h3 {
    margin-top: 8px;
    font-size: 21px;
    line-height: 1.15;
  }
  .card p {
    margin-top: 10px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--steel);
  }

  @media (max-width: 960px) {
    .cards {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .card {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      grid-template-rows: none;
    }
    .card__phone {
      height: auto;
      min-height: 100%;
      padding: 24px 0 0 20px;
    }
    .card__phone .phone {
      width: 92%;
    }
    .card__phone::after {
      inset: 0 0 0 auto;
      width: 30%;
      height: auto;
      background: linear-gradient(90deg, transparent, rgba(23, 25, 32, 0.95));
    }
    .card h3 {
      font-size: 19px;
    }
  }
  @media (max-width: 560px) {
    .card {
      grid-template-columns: 1fr;
    }
    .card__phone {
      height: 280px;
      min-height: 0;
      padding: 22px 0 0;
      justify-content: center;
    }
    .card__phone .phone {
      width: 62%;
    }
    .card__phone::after {
      inset: auto 0 0;
      width: auto;
      height: 30%;
      background: linear-gradient(180deg, transparent, rgba(23, 25, 32, 0.95));
    }
  }
</style>
