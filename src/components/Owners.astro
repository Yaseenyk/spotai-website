---
const base = import.meta.env.BASE_URL;
const problems = [
  {
    problem: 'Dues chased on WhatsApp',
    fix: 'Overdue members in one list with days late. Reminders respect each member’s consent. Members pay inside the app with UPI and the reference lands in your ledger.',
    src: 'o-dues.webp',
    alt: 'Dues screen listing Sana and Rohan with ₹1,000 each, days overdue, last visit and a Send reminder button',
  },
  {
    problem: 'No idea who came today',
    fix: 'Arrivals as they happen with dues flagged on the name, active members, memberships ending this week, and collected this month against last.',
    src: 'o-overview.webp',
    alt: 'Owner overview: arrivals today, active members, ₹2,000 overdue, ₹9,000 collected, daily visits bar chart, busy hours and a live arrivals list',
  },
  {
    problem: 'Guessing the busy hours',
    fix: 'Visits by weekday and hour over four weeks, who came back from last month, who uses the coach. Figures from fewer than five members stay hidden.',
    src: 'o-insights.webp',
    alt: 'Insights: members who visited 82%, came back from the month before 100%, visits per week 3, members using the AI coach 36%, visits by weekday chart',
  },
];
const more = [
  ['Front desk console', 'Check-in by QR or by name. Staff see who is in and who owes, nothing else.'],
  ['Trainer console', 'Review the AI coach’s tip templates with each flag’s wrong-rate, endorse helpers, moderate the community.'],
  ['Complaints with a reference', 'A member files from the app, gets a number, and you see it in the dashboard. Required under India’s DPDP rules.'],
  ['Face check-in, your call', 'An optional entrance device with liveness check and encrypted templates, nothing in the cloud. Stays in shadow mode until calibrated with consenting members.'],
];
---

<section class="section owners" id="owners" aria-labelledby="owners-title">
  <div class="wrap">
    <div class="owners__head">
      <p class="owners__for">For gym owners</p>
      <h2 id="owners-title">Chasing dues on WhatsApp? Run the gym from one screen.</h2>
      <p class="lead">
        Most gym software in India is a register with a login. SpotAI shows you who came, who owes, and when the
        floor is busy, and gives members a reason to keep coming.
      </p>
      <a class="more-link" href={`${base}features/owners/`}>The owner console in full</a>
    </div>

    <ul class="shots" role="list">
      {
        problems.map((p) => (
          <li class="shot">
            <div class="shot__frame">
              <div class="shot__bar" aria-hidden="true"><i></i><i></i><i></i><span>owner.spotai.app</span></div>
              <div class="shot__img">
                <img src={`${base}shots/${p.src}`} width="1600" height="1000" alt={p.alt} loading="lazy" decoding="async" />
              </div>
            </div>
            <div class="shot__text">
              <span class="shot__app">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2" /><path d="M8 20h8" /></svg>
                Owner console, in the browser
              </span>
              <h3>{p.problem}</h3>
              <p>{p.fix}</p>
            </div>
          </li>
        ))
      }
    </ul>

    <ul class="more" role="list">
      {
        more.map(([t, b]) => (
          <li>
            <h3>{t}</h3>
            <p>{b}</p>
          </li>
        ))
      }
    </ul>

    <div class="owners__cta">
      <p>Running a gym in India? We set up a pilot with you.</p>
      <a href="#download" class="btn btn--primary">Talk to us</a>
    </div>
  </div>
</section>

<style>
  .owners {
    background: linear-gradient(180deg, transparent, rgba(139, 92, 246, 0.05) 30%, rgba(139, 92, 246, 0.05) 70%, transparent);
  }
  .owners__head {
    max-width: 720px;
    margin-bottom: clamp(32px, 5vw, 56px);
  }
  .owners__for {
    display: inline-block;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(139, 92, 246, 0.16);
    color: var(--violet-2);
    font-size: 13px;
    font-weight: 700;
  }
  .owners__head h2 {
    margin-top: 16px;
    font-size: clamp(30px, 3.4vw, 46px);
  }
  .owners__head .lead {
    margin-top: 14px;
  }

  .shots {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .shot {
    display: grid;
    grid-template-rows: auto 1fr;
    border-radius: 20px;
    background: linear-gradient(180deg, #1f2129, #171920);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.07),
      0 0 0 1px var(--line),
      0 30px 50px -30px rgba(0, 0, 0, 0.9);
    overflow: hidden;
  }
  .shot__frame {
    margin: 20px 20px 0;
    border-radius: 12px 12px 0 0;
    background: #e9eaef;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.5);
    overflow: hidden;
  }
  .shot__bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 10px;
    background: #dcdde3;
  }
  .shot__bar i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #b7b9c2;
  }
  .shot__bar span {
    margin-left: 8px;
    padding: 2px 10px;
    border-radius: 6px;
    background: #fff;
    font-size: 10px;
    color: #6b7080;
  }
  /* The console screens are mostly empty below the fold; zoom to the top-left content. */
  .shot__img {
    aspect-ratio: 16 / 11;
    overflow: hidden;
  }
  .shot__img img {
    width: 150%;
    height: auto;
    max-width: none;
  }
  .shot__text {
    padding: 18px 22px 24px;
  }
  .shot__app {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--violet-2);
  }
  .shot h3 {
    margin-top: 8px;
    font-size: 21px;
    line-height: 1.15;
  }
  .shot p {
    margin-top: 10px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--steel);
  }

  .more {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0 28px;
    margin: 36px 0 0;
    padding: 0;
    list-style: none;
  }
  .more li {
    padding: 16px 0 18px;
    border-top: 1px solid var(--line);
  }
  .more h3 {
    font-size: 16.5px;
    font-variation-settings: 'wdth' 105;
    letter-spacing: -0.01em;
  }
  .more p {
    margin-top: 6px;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--steel);
  }

  .owners__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 40px;
    padding: 24px 28px;
    border-radius: 16px;
    background: rgba(139, 92, 246, 0.14);
    box-shadow: inset 0 0 0 1px rgba(196, 181, 253, 0.3);
  }
  .owners__cta p {
    font-size: 19px;
    font-weight: 700;
  }

  @media (max-width: 960px) {
    .shots {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .more {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .more {
      grid-template-columns: 1fr;
    }
    .owners__cta p {
      font-size: 17px;
    }
  }
</style>
