---
import { SITE } from '../site';
import { strings } from '../i18n/strings';
import { langOf, localize } from '../i18n/config';
const code = langOf(Astro.url.pathname);
const T = strings(code);
const t = T.owners;
const base = import.meta.env.BASE_URL;
const shots = ['o-dues.webp', 'o-overview.webp', 'o-insights.webp'];
const problems = t.problems.map((p, i) => ({ ...p, src: shots[i]! }));
---

<section class="section owners" id="owners" aria-labelledby="owners-title">
  <div class="wrap">
    <div class="owners__head">
      <p class="owners__for">{t.for}</p>
      <h2 id="owners-title">{t.title}</h2>
      <p class="lead">{t.lead}</p>
      <a class="more-link" href={localize('/for-gym-owners/', code)}>{t.more}</a>
    </div>

    <ul class="shots" role="list">
      {
        problems.map((p) => (
          <li class="shot">
            <div class="shot__frame">
              <div class="shot__bar" aria-hidden="true"><i></i><i></i><i></i><span>owner.spotai.app</span></div>
              <div class="shot__img">
                <img src={`${base}shots/${p.src}`} width="1600" height="1000" alt={p.alt} loading="lazy" decoding="async" />
              </div>
            </div>
            <div class="shot__text">
              <span class="shot__app">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2" /><path d="M8 20h8" /></svg>
                {t.console}
              </span>
              <h3>{p.problem}</h3>
              <p>{p.fix}</p>
            </div>
          </li>
        ))
      }
    </ul>

    <ul class="more" role="list">
      {
        t.extras.map((m) => (
          <li>
            <h3>{m.title}</h3>
            <p>{m.body}</p>
          </li>
        ))
      }
    </ul>

    <div class="owners__cta">
      <p>{t.cta}</p>
      <a href={`https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(T.common.waOwnerPilot)}`} target="_blank" rel="noopener" class="btn btn--primary">{T.common.chatWhatsApp}</a>
    </div>
  </div>
</section>

<style>
  .owners {
    background: linear-gradient(180deg, transparent, rgba(139, 92, 246, 0.05) 30%, rgba(139, 92, 246, 0.05) 70%, transparent);
  }
  .owners__head {
    max-width: 720px;
    margin-bottom: clamp(32px, 5vw, 56px);
  }
  .owners__for {
    display: inline-block;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(139, 92, 246, 0.16);
    color: var(--violet-2);
    font-size: 13px;
    font-weight: 700;
  }
  .owners__head h2 {
    margin-top: 16px;
    font-size: clamp(30px, 3.4vw, 46px);
  }
  .owners__head .lead {
    margin-top: 14px;
  }

  .shots {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .shot {
    display: grid;
    grid-template-rows: auto 1fr;
    border-radius: 20px;
    background: linear-gradient(180deg, #1f2129, #171920);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.07),
      0 0 0 1px var(--line),
      0 30px 50px -30px rgba(0, 0, 0, 0.9);
    overflow: hidden;
  }
  .shot__frame {
    margin: 20px 20px 0;
    border-radius: 12px 12px 0 0;
    background: #1b1d24;
    box-shadow: 0 0 0 1px rgba(236, 233, 225, 0.16);
    overflow: hidden;
  }
  .shot__bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 10px;
    background: #23262e;
  }
  .shot__bar i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #4a4f5c;
  }
  .shot__bar span {
    margin-left: 8px;
    padding: 2px 10px;
    border-radius: 6px;
    background: #141518;
    font-size: 10px;
    color: #8d93a1;
  }
  .shot__img {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }
  .shot__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .shot__text {
    padding: 18px 22px 24px;
  }
  .shot__app {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--violet-2);
  }
  .shot h3 {
    margin-top: 8px;
    font-size: 21px;
    line-height: 1.15;
  }
  .shot p {
    margin-top: 10px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--steel);
  }

  .more {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0 28px;
    margin: 36px 0 0;
    padding: 0;
    list-style: none;
  }
  .more li {
    padding: 16px 0 18px;
    border-top: 1px solid var(--line);
  }
  .more h3 {
    font-size: 16.5px;
    font-variation-settings: 'wdth' 105;
    letter-spacing: -0.01em;
  }
  .more p {
    margin-top: 6px;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--steel);
  }

  .owners__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 40px;
    padding: 24px 28px;
    border-radius: 16px;
    background: rgba(139, 92, 246, 0.14);
    box-shadow: inset 0 0 0 1px rgba(196, 181, 253, 0.3);
  }
  .owners__cta p {
    font-size: 19px;
    font-weight: 700;
  }

  @media (max-width: 960px) {
    .shots {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .more {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .more {
      grid-template-columns: 1fr;
    }
    .owners__cta p {
      font-size: 17px;
    }
  }
</style>
