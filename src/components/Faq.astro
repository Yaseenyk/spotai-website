---
import { FAQ } from '../site';
---

<section class="section faq" id="faq" aria-labelledby="faq-title">
  <div class="wrap faq__in">
    <div class="faq__head">
      <h2 id="faq-title">Questions gym members and owners ask first</h2>
      <p class="lead">Straight answers. Write to us if yours is not here.</p>
    </div>
    <div class="faq__list">
      {
        FAQ.map((f, i) => (
          <details class="faq__item" open={i === 0}>
            <summary>
              <h3>{f.q}</h3>
              <span class="faq__plus" aria-hidden="true" />
            </summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq__in {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }
  .faq__head {
    position: sticky;
    top: 96px;
  }
  .faq__head h2 {
    font-size: clamp(30px, 3.2vw, 44px);
  }
  .faq__head .lead {
    margin-top: 14px;
  }
  .faq__item {
    border-top: 1px solid var(--line);
  }
  .faq__item:last-child {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 0;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary h3 {
    font-size: 18px;
    font-variation-settings: 'wdth' 105;
    letter-spacing: -0.01em;
  }
  .faq__plus {
    position: relative;
    flex: 0 0 auto;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--line-2);
  }
  .faq__plus::before,
  .faq__plus::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 2px;
    background: var(--chalk);
    translate: -50% -50%;
    transition: transform 0.3s var(--ease);
  }
  .faq__plus::after {
    transform: rotate(90deg);
  }
  details[open] .faq__plus::after {
    transform: rotate(0);
  }
  .faq__item p {
    padding: 0 48px 20px 0;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--steel);
  }

  @media (max-width: 960px) {
    .faq__in {
      grid-template-columns: 1fr;
    }
    .faq__head {
      position: static;
    }
  }
</style>
