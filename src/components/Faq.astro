---
import { FAQ } from '../site';
---

<section class="section faq" id="faq" aria-labelledby="faq-title">
  <div class="wrap faq__in">
    <div class="section__head" data-reveal>
      <p class="mono eyebrow">Questions</p>
      <h2 id="faq-title">Questions gym members and owners ask first</h2>
      <p class="lead">What members and gym owners ask us first.</p>
    </div>
    <div class="faq__list">
      {
        FAQ.map((f, i) => (
          <details class="faq__item" data-reveal style={`--d: ${i * 0.04}s`} open={i === 0}>
            <summary>
              <h3>{f.q}</h3>
              <span class="faq__plus" aria-hidden="true" />
            </summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq__in {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .faq__list {
    display: grid;
    gap: 10px;
  }
  .faq__item {
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.03);
    box-shadow: inset 0 0 0 1px var(--line);
    transition: background 0.3s ease;
  }
  .faq__item[open] {
    background: rgba(255, 255, 255, 0.05);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 20px;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary h3 {
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .faq__plus {
    position: relative;
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.07);
  }
  .faq__plus::before,
  .faq__plus::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 2px;
    background: var(--cyan-300);
    translate: -50% -50%;
    transition: transform 0.3s var(--ease);
  }
  .faq__plus::after {
    transform: rotate(90deg);
  }
  .faq__item[open] .faq__plus::after {
    transform: rotate(0deg);
  }
  .faq__item p {
    padding: 0 20px 20px;
    color: var(--muted);
    font-size: 15.5px;
  }
  @media (max-width: 860px) {
    .faq__in {
      grid-template-columns: 1fr;
    }
  }
</style>
