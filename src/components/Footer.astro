---
import { SITE } from '../site';
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer__in">
    <div class="footer__brand">
      <a href={base} class="footer__logo wide" aria-label="SpotAI home">
        <img src={`${base}icon.svg`} width="28" height="28" alt="" />
        <span>SpotAI</span>
      </a>
      <p>{SITE.tagline}.</p>
    </div>
    <nav aria-label="Footer" class="footer__nav">
      <a href="#members">Members</a>
      <a href="#coach">AI coach</a>
      <a href="#gains">Gains</a>
      <a href="#owners">Gym owners</a>
      <a href="#privacy">Privacy</a>
      <a href="#faq">FAQ</a>
    </nav>
    <div class="footer__contact">
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      <a href={SITE.author.url} rel="author">Made by {SITE.author.name}</a>
      <a href={`${base}llms.txt`}>llms.txt</a>
    </div>
  </div>
  <p class="wrap footer__legal">© {year} SpotAI · Hyderabad, India · Not medical advice. Train with a qualified coach.</p>
</footer>

<style>
  .footer {
    padding: 48px 0 28px;
    border-top: 1px solid var(--line);
  }
  .footer__in {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) auto auto;
    gap: 32px 56px;
    align-items: start;
  }
  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 18px;
    text-decoration: none;
  }
  .footer__logo img {
    border-radius: 8px;
  }
  .footer__brand p {
    margin-top: 10px;
    max-width: 36ch;
    font-size: 14px;
    color: var(--steel);
  }
  .footer__nav,
  .footer__contact {
    display: grid;
    gap: 10px;
  }
  .footer__nav a,
  .footer__contact a {
    font-size: 14.5px;
    color: var(--steel);
    text-decoration: none;
  }
  .footer__nav a:hover,
  .footer__contact a:hover {
    color: var(--chalk);
  }
  .footer__legal {
    margin-top: 36px;
    font-size: 12.5px;
    color: var(--dim);
  }
  @media (max-width: 700px) {
    .footer__in {
      grid-template-columns: 1fr;
    }
  }
</style>
