{
  "name": "SpotAI demo",
  "short_name": "SpotAI",
  "description": "Offline demo of the SpotAI member app. Everything you log stays on this phone.",
  "start_url": "/demo/#/",
  "scope": "/demo/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#1b1b1e",
  "theme_color": "#1b1b1e",
  "icons": [
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "/demo/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
}